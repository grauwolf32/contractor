  "reader": {
    "name": "list_findings",
    "description": "List finding proposals from this Run's prepared collection.\n\nReturns bounded previews and exact current-Run artifact references. Use\nread_artifact with proposal.ref or evidence[].ref for full content. Source\nrefs are provenance only. Captured Project Finding metadata describes the collection snapshot;\nlisting does not confirm, deduplicate or change a finding.\n\nArgs:\n    subject_kind: Optional exact, case-sensitive subject kind identifier.\n    subject_key: Optional exact subject key; requires subject_kind.\n    limit: Maximum items to return, from 1 to 100; defaults to 20. The byte\n        limit may shorten a page. Follow next_cursor until it is null.\n    cursor: Opaque next_cursor from this collection with the same filters.\n        Omit for the first page. The limit may change between pages.\n\nReturns:\n    items with receipt identity, subject, title and description previews,\n    hypothesis presence, proposal and evidence refs, and the captured\n    Project Finding when published;\n    next_cursor is null when no matching entries remain. No matches returns\n    an empty items list. Invalid filters or cursors and oversized individual\n    items fail explicitly without dropping entries.",
    "parameters": {
      "properties": {
        "subject_kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject Kind"
        },
        "subject_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject Key"
        },
        "limit": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit"
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cursor"
        }
      },
      "title": "list_findingsParams",
      "type": "object"
    }
  }
}
