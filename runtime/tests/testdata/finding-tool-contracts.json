{
  "general": {
    "name": "finding",
    "description": "Record one finding with optional source/web locations.\n\nA proposal records an observation, not a confirmed vulnerability. Describe\nthe impact and supporting observations. Locations may combine code and HTTP.\nEach location is either file with optional line/range, or url with optional\nmethod. Omit unknown coordinates and classification instead of guessing.\n\nArgs:\n    title: Short non-empty finding title.\n    description: Observation, impact, prerequisites and reproduction details.\n    locations: Optional explicit source or web locations.\n    request_id: Optional recent http_request ID from this invocation.\n    caido_request_id: Optional Caido ID inspected in this invocation. Select\n        one HTTP source; selected exchanges are saved automatically.\n    cwe: Optional CWE-NNN weakness identifier from the pinned catalog.\n    evidence_refs: Optional exact artifact references copied from tool output.\n    standard_refs: Optional exact standard identities copied from an assigned\n        Audit task. A finding linked to a standard-mapped Audit result must\n        cite every assigned entry ID.",
    "parameters": {
      "$defs": {
        "ExactEvidenceRef": {
          "additionalProperties": false,
          "properties": {
            "namespace": {
              "title": "Namespace",
              "type": "string"
            },
            "name": {
              "title": "Name",
              "type": "string"
            },
            "revision": {
              "minLength": 1,
              "title": "Revision",
              "type": "string"
            }
          },
          "required": [
            "namespace",
            "name",
            "revision"
          ],
          "title": "ExactEvidenceRef",
          "type": "object"
        },
        "LineRange": {
          "additionalProperties": false,
          "properties": {
            "start_line": {
              "maximum": 9007199254740991,
              "minimum": 1,
              "title": "Start Line",
              "type": "integer"
            },
            "end_line": {
              "maximum": 9007199254740991,
              "minimum": 1,
              "title": "End Line",
              "type": "integer"
            }
          },
          "required": [
            "start_line",
            "end_line"
          ],
          "title": "LineRange",
          "type": "object"
        },
        "SourceLocation": {
          "additionalProperties": false,
          "properties": {
            "file": {
              "title": "File",
              "type": "string"
            },
            "line": {
              "default": null,
              "maximum": 9007199254740991,
              "minimum": 1,
              "title": "Line",
              "type": "integer"
            },
            "range": {
              "$ref": "#/$defs/LineRange",
              "default": null,
              "title": "Range"
            }
          },
          "required": [
            "file"
          ],
          "title": "SourceLocation",
          "type": "object"
        },
        "StandardReference": {
          "additionalProperties": false,
          "properties": {
            "scheme": {
              "title": "Scheme",
              "type": "string"
            },
            "version": {
              "title": "Version",
              "type": "string"
            },
            "requirement_id": {
              "title": "Requirement Id",
              "type": "string"
            }
          },
          "required": [
            "scheme",
            "version",
            "requirement_id"
          ],
          "title": "StandardReference",
          "type": "object"
        },
        "WebLocation": {
          "additionalProperties": false,
          "properties": {
            "url": {
              "title": "Url",
              "type": "string"
            },
            "method": {
              "default": null,
              "title": "Method",
              "type": "string"
            }
          },
          "required": [
            "url"
          ],
          "title": "WebLocation",
          "type": "object"
        }
      },
      "properties": {
        "title": {
          "title": "Title",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "locations": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/SourceLocation"
                  },
                  {
                    "$ref": "#/$defs/WebLocation"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locations"
        },
        "request_id": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "caido_request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caido Request Id"
        },
        "cwe": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cwe"
        },
        "evidence_refs": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ExactEvidenceRef"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Refs"
        },
        "standard_refs": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/StandardReference"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Standard Refs"
        }
      },
      "required": [
        "title",
        "description"
      ],
      "title": "findingParams",
      "type": "object"
    }
  },
  "code": {
    "name": "finding",
