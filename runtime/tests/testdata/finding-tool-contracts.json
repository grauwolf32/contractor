    "parameters": {
      "$defs": {
        "ExactEvidenceRef": {
          "additionalProperties": false,
          "properties": {
            "namespace": {
              "title": "Namespace",
              "type": "string"
            },
            "name": {
              "title": "Name",
              "type": "string"
            },
            "revision": {
              "minLength": 1,
              "title": "Revision",
              "type": "string"
            }
          },
          "required": [
            "namespace",
            "name",
            "revision"
          ],
          "title": "ExactEvidenceRef",
          "type": "object"
        },
        "LineRange": {
          "additionalProperties": false,
          "properties": {
            "start_line": {
              "maximum": 9007199254740991,
              "minimum": 1,
              "title": "Start Line",
              "type": "integer"
            },
            "end_line": {
              "maximum": 9007199254740991,
              "minimum": 1,
              "title": "End Line",
              "type": "integer"
            }
          },
          "required": [
            "start_line",
            "end_line"
          ],
          "title": "LineRange",
          "type": "object"
        },
        "StandardReference": {
          "additionalProperties": false,
          "properties": {
            "scheme": {
              "title": "Scheme",
              "type": "string"
            },
            "version": {
              "title": "Version",
              "type": "string"
            },
            "requirement_id": {
              "title": "Requirement Id",
              "type": "string"
            }
          },
          "required": [
            "scheme",
            "version",
            "requirement_id"
          ],
          "title": "StandardReference",
          "type": "object"
        }
      },
      "properties": {
        "title": {
          "title": "Title",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "file": {
          "title": "File",
          "type": "string"
        },
        "line": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line"
        },
        "range": {
          "anyOf": [
            {
              "$ref": "#/$defs/LineRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cwe": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cwe"
        },
        "evidence_refs": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ExactEvidenceRef"
              },
              "type": "array"
            },
            {
              "type": "null"
