{
  "general": {
    "name": "finding",
    "description": "Record one finding with optional source/web locations.\n\nA proposal records an observation, not a confirmed vulnerability. Describe\nthe impact and supporting observations. Locations may combine code and HTTP.\nEach location is either file with optional line/range, or url with optional\nmethod. Omit unknown coordinates and classification instead of guessing.\n\nArgs:\n    title: Short non-empty finding title.\n    description: Observation, impact, prerequisites and reproduction details.\n    locations: Optional explicit source or web locations.\n    request_id: Optional local HTTP/Caido request_id inspected in this invocation.\n        The selected captured exchange is saved automatically.\n    cwe: Optional CWE-NNN weakness identifier from the pinned catalog.\n    evidence_refs: Optional exact artifact references copied from tool output.\n        With any selected exchange they total at most 64 MiB; a larger set\n        fails with invalid_finding_request, so cite fewer artifacts.\n    standard_refs: Optional exact standard identities copied from an assigned\n        Audit task. A finding linked to a standard-mapped Audit result must\n        cite every assigned entry ID.\n    proposed_checks: Optional follow-up questions, each with objective and\n        method. At most 512; these suggestions grant no execution authority.\n    item_key: Optional actual Audit member key from read_audit_task. Required\n        for task-bound batches; omit for a general incidental observation.\n    incidental: An independent discovery that does not test the assigned hypothesis.\n        Without item_key, retains Run/Audit origin only. Selecting a member adds\n        Task origin; incidental calls never associate its hypothesis.\n    severity_suggestion: Optional producer severity; leaves analyst assessment unset.\n        Saving always requires an active Project and selected exact evidence.",
    "parameters": {
      "$defs": {
        "ExactEvidenceRef": {
          "additionalProperties": false,
          "properties": {
            "namespace": {
              "title": "Namespace",
              "type": "string"
            },
            "name": {
              "title": "Name",
              "type": "string"
            },
            "revision": {
              "minLength": 1,
              "title": "Revision",
              "type": "string"
            }
          },
          "required": [
            "namespace",
            "name",
            "revision"
          ],
          "title": "ExactEvidenceRef",
          "type": "object"
        },
        "LineRange": {
          "additionalProperties": false,
          "properties": {
            "start_line": {
              "maximum": 9007199254740991,
              "minimum": 1,
              "title": "Start Line",
              "type": "integer"
            },
            "end_line": {
              "maximum": 9007199254740991,
              "minimum": 1,
              "title": "End Line",
              "type": "integer"
            }
          },
          "required": [
            "start_line",
            "end_line"
          ],
          "title": "LineRange",
          "type": "object"
        },
        "ProposedCheck": {
          "additionalProperties": false,
          "description": "One follow-up question; its method grants no execution authority.",
          "properties": {
            "objective": {
              "title": "Objective",
              "type": "string"
            },
            "method": {
              "title": "Method",
              "type": "string"
            }
          },
          "required": [
            "objective",
            "method"
          ],
          "title": "ProposedCheck",
          "type": "object"
        },
        "SourceLocation": {
          "additionalProperties": false,
          "properties": {
            "file": {
              "title": "File",
              "type": "string"
            },
            "line": {
              "default": null,
              "maximum": 9007199254740991,
              "minimum": 1,
              "title": "Line",
              "type": "integer"
            },
            "range": {
              "$ref": "#/$defs/LineRange",
              "default": null,
              "title": "Range"
            }
          },
          "required": [
            "file"
          ],
          "title": "SourceLocation",
          "type": "object"
        },
        "StandardReference": {
          "additionalProperties": false,
          "properties": {
            "scheme": {
              "title": "Scheme",
              "type": "string"
            },
            "version": {
              "title": "Version",
              "type": "string"
            },
            "requirement_id": {
              "title": "Requirement Id",
              "type": "string"
            }
          },
          "required": [
            "scheme",
            "version",
            "requirement_id"
          ],
          "title": "StandardReference",
          "type": "object"
        },
        "WebLocation": {
          "additionalProperties": false,
          "properties": {
            "url": {
              "title": "Url",
              "type": "string"
            },
            "method": {
              "default": null,
              "title": "Method",
              "type": "string"
            }
          },
          "required": [
            "url"
          ],
          "title": "WebLocation",
          "type": "object"
        }
      },
      "properties": {
        "title": {
          "title": "Title",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "locations": {
          "anyOf": [
            {
              "items": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/SourceLocation"
                  },
                  {
                    "$ref": "#/$defs/WebLocation"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locations"
        },
        "request_id": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "cwe": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cwe"
        },
        "evidence_refs": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ExactEvidenceRef"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Refs"
        },
        "standard_refs": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/StandardReference"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Standard Refs"
        },
        "proposed_checks": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ProposedCheck"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Proposed Checks"
        },
        "severity_suggestion": {
          "anyOf": [
            {
              "enum": [
                "informational",
                "low",
                "medium",
                "high",
                "critical"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Severity Suggestion"
        },
        "item_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Item Key"
        },
        "incidental": {
          "default": false,
          "title": "Incidental",
          "type": "boolean"
        }
      },
      "required": [
        "title",
        "description"
      ],
      "title": "findingParams",
      "type": "object"
    }
  },
  "fact": {
    "name": "record_fact",
    "description": "Save one informational Project observation with exact evidence.\n\nAn active Project and selected exact evidence are required. Describe what the\nsource actually reports, including uncertainty; a note is a reported claim.\nThe record has no automatic analyst verdict or severity assessment.\n\nArgs:\n    title: Short non-empty observation title.\n    description: Observation, source quality, conditions and limitations.\n    evidence_refs: Exact artifact references copied from tool output. At most four\n        sources including a selected HTTP exchange; authored content is at most 32 KiB.\n    request_id: Optional local HTTP/Caido request ID; saves its captured exchange.\n    item_key: Optional assigned Audit member key to retain Task origin.\n    incidental: True retains Run/Audit origin without a hypothesis. Set false\n        to derive the selected Task's exact hypothesis; batch tasks need item_key.",
    "parameters": {
      "$defs": {
        "ExactEvidenceRef": {
          "additionalProperties": false,
          "properties": {
            "namespace": {
              "title": "Namespace",
              "type": "string"
            },
            "name": {
              "title": "Name",
              "type": "string"
            },
            "revision": {
              "minLength": 1,
              "title": "Revision",
              "type": "string"
            }
          },
          "required": [
            "namespace",
            "name",
            "revision"
          ],
          "title": "ExactEvidenceRef",
          "type": "object"
        }
      },
      "properties": {
        "title": {
          "title": "Title",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "evidence_refs": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ExactEvidenceRef"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Refs"
        },
        "request_id": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "item_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Item Key"
        },
        "incidental": {
          "default": true,
          "title": "Incidental",
          "type": "boolean"
        }
      },
      "required": [
        "title",
        "description"
      ],
      "title": "record_factParams",
      "type": "object"
    }
  },
