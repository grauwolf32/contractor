  "http": {
    "name": "finding",
    "description": "Record one HTTP finding at an explicit URL and method.\n\nDescribe the observed behavior, impact and authorization context. An optional\nrequest_id attaches the captured outgoing request and response evidence from\nthis invocation's recent HTTP history. Omit the ID to report without captured\nevidence. Reporting never sends or replays an HTTP request.\n\nArgs:\n    title: Short non-empty finding title.\n    description: Observations, impact, prerequisites and reproduction details.\n    url: Absolute HTTP/HTTPS URL of the affected endpoint.\n    method: Explicit HTTP method; no default method is inferred.\n    request_id: Optional ID returned by http_request in this invocation.\n    caido_request_id: Optional ID from caido_request_detail or a completed\n        caido_replay in this invocation. Select this or request_id; finding\n        saves the selected exchange automatically without sending traffic.\n    cwe: Optional CWE-NNN weakness identifier from the pinned catalog.\n    evidence_refs: Optional exact artifact references copied from tool output.\n    standard_refs: Optional exact standard identities copied from an assigned\n        Audit task. A finding linked to a standard-mapped Audit result must\n        cite every assigned entry ID.",
    "parameters": {
      "$defs": {
        "ExactEvidenceRef": {
          "additionalProperties": false,
          "properties": {
            "namespace": {
              "title": "Namespace",
              "type": "string"
            },
            "name": {
              "title": "Name",
              "type": "string"
            },
            "revision": {
              "minLength": 1,
              "title": "Revision",
              "type": "string"
            }
          },
          "required": [
            "namespace",
            "name",
            "revision"
          ],
          "title": "ExactEvidenceRef",
          "type": "object"
        },
        "StandardReference": {
          "additionalProperties": false,
          "properties": {
            "scheme": {
              "title": "Scheme",
              "type": "string"
            },
            "version": {
              "title": "Version",
              "type": "string"
            },
            "requirement_id": {
              "title": "Requirement Id",
              "type": "string"
            }
          },
          "required": [
            "scheme",
            "version",
            "requirement_id"
          ],
          "title": "StandardReference",
          "type": "object"
        }
      },
      "properties": {
        "title": {
          "title": "Title",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        },
        "method": {
          "title": "Method",
          "type": "string"
        },
        "request_id": {
          "anyOf": [
            {
              "maximum": 9007199254740991,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "caido_request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Caido Request Id"
        },
        "cwe": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cwe"
        },
        "evidence_refs": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ExactEvidenceRef"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Refs"
        },
        "standard_refs": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/StandardReference"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Standard Refs"
        }
      },
      "required": [
        "title",
        "description",
        "url",
        "method"
      ],
      "title": "findingParams",
      "type": "object"
    }
  },
  "reader": {
    "name": "list_findings",
    "description": "List finding proposals from this Run's prepared collection.\n\nReturns bounded previews and exact current-Run artifact references. Use\nread_artifact with proposal.ref or evidence[].ref for full content. Source\nrefs are provenance only. Captured reviews describe the collection snapshot;\nlisting does not confirm, deduplicate or change a finding.\n\nArgs:\n    subject_kind: Optional exact, case-sensitive subject kind identifier.\n    subject_key: Optional exact subject key; requires subject_kind.\n    limit: Maximum items to return, from 1 to 100; defaults to 20. The byte\n        limit may shorten a page. Follow next_cursor until it is null.\n    cursor: Opaque next_cursor from this collection with the same filters.\n        Omit for the first page. The limit may change between pages.\n\nReturns:\n    items with receipt identity, subject, title and description previews,\n    hypothesis presence, proposal and evidence refs, and captured reviews;\n    next_cursor is null when no matching entries remain. No matches returns\n    an empty items list. Invalid filters or cursors and oversized individual\n    items fail explicitly without dropping entries.",
    "parameters": {
      "properties": {
        "subject_kind": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject Kind"
        },
        "subject_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Subject Key"
        },
        "limit": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit"
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cursor"
        }
      },
      "title": "list_findingsParams",
      "type": "object"
    }
  }
}
