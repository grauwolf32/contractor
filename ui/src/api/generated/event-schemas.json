{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractor.local/schemas/contractor-events-v1.schema.json",
  "oneOf": [
    {
      "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/SubscribeFrame"
    },
    {
      "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/UnsubscribeFrame"
    },
    {
      "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/SubscribedFrame"
    },
    {
      "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/UnsubscribedFrame"
    },
    {
      "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/EventFrame"
    },
    {
      "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/ResyncRequiredFrame"
    },
    {
      "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/ErrorFrame"
    }
  ],
  "$defs": {
    "ProtocolVersion": { "const": "contractor.events.v1" },
    "SafeIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "SubscriptionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "RunStream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "const": "run" },
        "id": {
          "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/SafeIdentifier"
        }
      }
    },
    "OperationsStream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": { "kind": { "const": "operations" } }
    },
    "Stream": {
      "oneOf": [
        {
          "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/RunStream"
        },
        {
          "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/OperationsStream"
        }
      ]
    },
    "Cursor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "sequence"],
      "properties": {
        "generation": {
          "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/SafeIdentifier"
        },
        "sequence": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^(0|[1-9][0-9]*)$"
        }
      }
    },
    "SubscribeFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "type", "subscriptionId", "stream"],
      "properties": {
        "version": {
          "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/ProtocolVersion"
        },
        "type": { "const": "subscribe" },
        "subscriptionId": {
          "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/SubscriptionId"
        },
        "stream": {
          "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/Stream"
        },
        "after": {
          "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/Cursor"
        }
      }
    },
    "UnsubscribeFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "type", "subscriptionId"],
      "properties": {
        "version": {
          "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/ProtocolVersion"
        },
        "type": { "const": "unsubscribe" },
        "subscriptionId": {
          "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/SubscriptionId"
        }
      }
    },
    "SubscribedFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "type", "subscriptionId", "stream", "cursor"],
      "properties": {
        "version": {
          "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/ProtocolVersion"
        },
        "type": { "const": "subscribed" },
        "subscriptionId": {
          "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/SubscriptionId"
        },
        "stream": {
          "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/Stream"
        },
        "cursor": {
          "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/Cursor"
        }
      }
    },
    "UnsubscribedFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "type", "subscriptionId"],
      "properties": {
        "version": {
          "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/ProtocolVersion"
        },
        "type": { "const": "unsubscribed" },
        "subscriptionId": {
          "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/SubscriptionId"
        }
      }
    },
    "PlannerSubtask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "objective", "instructions", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,2})$" },
        "objective": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "instructions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32768
        },
        "status": { "enum": ["pending", "running", "succeeded", "failed"] }
      }
    },
    "ActiveDispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["callId", "subtaskId", "workerName"],
      "properties": {
        "callId": {
          "type": "string",
          "pattern": "^dispatch-[0-9]{4,}$",
          "maxLength": 64
        },
        "subtaskId": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,2})$" },
        "workerName": {
          "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/SafeIdentifier"
        }
      }
    },
    "PlannerPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "subtasks"],
      "properties": {
        "revision": { "type": "integer", "minimum": 1 },
        "subtasks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": {
            "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/PlannerSubtask"
          }
        },
        "currentSubtaskId": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,2})$"
        },
        "activeDispatch": {
          "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/ActiveDispatch"
        }
      }
    },
    "PlannerEventData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stageExecutionId",
        "sessionId",
        "invocationId",
        "eventKind"
      ],
      "properties": {
        "stageExecutionId": {
          "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/SafeIdentifier"
        },
        "sessionId": {
          "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/SafeIdentifier"
        },
        "invocationId": {
          "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/SafeIdentifier"
        },
        "eventKind": {
          "enum": [
            "planner.started",
            "planner.request_recorded",
            "planner.activity",
            "planner.plan_changed",
            "planner.current_changed",
            "planner.dispatch_selected",
            "planner.dispatch_started",
            "planner.dispatch_completed",
            "planner.finish_requested",
            "planner.completed",
            "planner.failed"
          ]
        },
        "plan": {
          "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/PlannerPlan"
        },
        "planRevision": { "type": "integer", "minimum": 0 },
        "subtaskId": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,2})$" },
        "callId": {
          "type": "string",
          "pattern": "^dispatch-[0-9]{4,}$",
          "maxLength": 64
        },
        "workerName": {
          "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/SafeIdentifier"
        },
        "outcome": { "enum": ["succeeded", "failed", "failure"] },
        "code": {
          "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/SafeIdentifier"
        },
        "activity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "author", "functionCalls", "functionResults"],
          "properties": {
            "kind": {
              "enum": [
                "adk_event",
                "scan_owner_acquired",
                "scan_plan_initialized",
                "scan_job_started",
                "scan_job_finished"
              ]
            },
            "author": {
              "enum": [
                "user",
                "streamline_planner",
                "router_planner",
                "other",
                "scan_planner"
              ]
            },
            "functionCalls": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/SafeIdentifier"
              }
            },
            "functionResults": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/SafeIdentifier"
              }
            },
            "inputTokens": { "type": "integer", "minimum": 0 },
            "outputTokens": { "type": "integer", "minimum": 0 },
            "skipSummarization": { "type": "boolean" },
            "escalate": { "type": "boolean" },
            "truncated": { "type": "boolean" }
          },
          "allOf": [
            {
              "if": { "properties": { "kind": { "const": "adk_event" } } },
              "then": {
                "properties": {
                  "author": {
                    "enum": [
                      "user",
                      "streamline_planner",
                      "router_planner",
                      "other"
                    ]
                  }
                }
              },
              "else": {
                "properties": {
                  "author": { "const": "scan_planner" },
                  "functionCalls": { "maxItems": 0 },
                  "functionResults": { "maxItems": 0 },
                  "inputTokens": { "const": 0 },
                  "outputTokens": { "const": 0 },
                  "skipSummarization": { "const": false },
                  "escalate": { "const": false },
                  "truncated": { "const": false }
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "eventKind": {
                "enum": ["planner.started", "planner.request_recorded"]
              }
            }
          },
          "then": {
            "not": {
              "anyOf": [
                { "required": ["plan"] },
                { "required": ["planRevision"] },
                { "required": ["subtaskId"] },
                { "required": ["callId"] },
                { "required": ["workerName"] },
                { "required": ["outcome"] },
                { "required": ["code"] },
                { "required": ["activity"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": { "eventKind": { "const": "planner.activity" } }
          },
          "then": {
            "required": ["activity"],
            "not": {
              "anyOf": [
                { "required": ["plan"] },
                { "required": ["planRevision"] },
                { "required": ["subtaskId"] },
                { "required": ["callId"] },
                { "required": ["workerName"] },
                { "required": ["outcome"] },
                { "required": ["code"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": { "eventKind": { "const": "planner.plan_changed" } }
          },
          "then": {
            "required": ["plan"],
            "properties": {
              "plan": {
                "allOf": [
                  {
                    "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/PlannerPlan"
                  },
                  { "not": { "required": ["activeDispatch"] } }
                ]
              }
            },
            "not": {
              "anyOf": [
                { "required": ["planRevision"] },
                { "required": ["subtaskId"] },
                { "required": ["callId"] },
                { "required": ["workerName"] },
                { "required": ["outcome"] },
                { "required": ["code"] },
                { "required": ["activity"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "eventKind": { "const": "planner.current_changed" }
            }
          },
          "then": {
            "required": ["planRevision"],
            "properties": { "planRevision": { "minimum": 1 } },
            "not": {
              "anyOf": [
                { "required": ["plan"] },
                { "required": ["callId"] },
                { "required": ["workerName"] },
                { "required": ["outcome"] },
                { "required": ["code"] },
                { "required": ["activity"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "eventKind": { "const": "planner.dispatch_selected" }
            }
          },
          "then": {
            "required": ["planRevision", "subtaskId", "callId", "workerName"],
            "properties": { "planRevision": { "minimum": 1 } },
            "not": {
              "anyOf": [
                { "required": ["plan"] },
                { "required": ["outcome"] },
                { "required": ["code"] },
                { "required": ["activity"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "eventKind": { "const": "planner.dispatch_started" }
            }
          },
          "then": {
            "required": ["plan", "subtaskId", "callId", "workerName"],
            "properties": {
              "plan": {
                "allOf": [
                  {
                    "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/PlannerPlan"
                  },
                  { "required": ["activeDispatch"] }
                ]
              }
            },
            "not": {
              "anyOf": [
                { "required": ["planRevision"] },
                { "required": ["outcome"] },
                { "required": ["code"] },
                { "required": ["activity"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "eventKind": { "const": "planner.dispatch_completed" }
            }
          },
          "then": {
            "required": [
              "plan",
              "subtaskId",
              "callId",
              "workerName",
              "outcome"
            ],
            "properties": {
              "outcome": { "enum": ["succeeded", "failed"] },
              "plan": {
                "allOf": [
                  {
                    "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/PlannerPlan"
                  },
                  { "not": { "required": ["activeDispatch"] } }
                ]
              }
            },
            "not": {
              "anyOf": [
                { "required": ["planRevision"] },
                { "required": ["code"] },
                { "required": ["activity"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "eventKind": { "const": "planner.finish_requested" }
            }
          },
          "then": {
            "required": ["planRevision", "outcome"],
            "properties": { "outcome": { "enum": ["succeeded", "failed"] } },
            "allOf": [
              {
                "if": { "properties": { "outcome": { "const": "succeeded" } } },
                "then": { "properties": { "planRevision": { "minimum": 1 } } }
              }
            ],
            "not": {
              "anyOf": [
                { "required": ["plan"] },
                { "required": ["subtaskId"] },
                { "required": ["callId"] },
                { "required": ["workerName"] },
                { "required": ["code"] },
                { "required": ["activity"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": { "eventKind": { "const": "planner.completed" } }
          },
          "then": {
            "required": ["outcome"],
            "properties": { "outcome": { "enum": ["succeeded", "failed"] } },
            "not": {
              "anyOf": [
                { "required": ["plan"] },
                { "required": ["planRevision"] },
                { "required": ["subtaskId"] },
                { "required": ["callId"] },
                { "required": ["workerName"] },
                { "required": ["code"] },
                { "required": ["activity"] }
              ]
            }
          }
        },
        {
          "if": {
            "properties": { "eventKind": { "const": "planner.failed" } }
          },
          "then": {
            "required": ["outcome", "code"],
            "properties": { "outcome": { "const": "failure" } },
            "not": {
              "anyOf": [
                { "required": ["plan"] },
                { "required": ["planRevision"] },
                { "required": ["subtaskId"] },
                { "required": ["callId"] },
                { "required": ["workerName"] },
                { "required": ["activity"] }
              ]
            }
          }
        }
      ]
    },
    "LifecycleEventData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "resource", "state"],
      "properties": {
        "runId": {
          "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/SafeIdentifier"
        },
        "resource": { "enum": ["run", "stageExecution"] },
        "stageExecutionId": {
          "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/SafeIdentifier"
        },
        "state": {
          "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/SafeIdentifier"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "resource": { "const": "stageExecution" } } },
          "then": { "required": ["stageExecutionId"] },
          "else": { "not": { "required": ["stageExecutionId"] } }
        }
      ]
    },
    "OperationsEventData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource", "revision"],
      "properties": {
        "resource": {
          "enum": [
            "runtimeAgent",
            "allocation",
            "configuration",
            "credential",
            "schedulerSettings",
            "modelSelection"
          ]
        },
        "resourceId": {
          "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/SafeIdentifier"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^(0|[1-9][0-9]*)$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "resource": { "enum": ["schedulerSettings", "modelSelection"] }
            }
          },
          "then": { "not": { "required": ["resourceId"] } }
        }
      ]
    },
    "EventFrame": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "type",
            "subscriptionId",
            "stream",
            "cursor",
            "kind",
            "occurredAt",
            "data"
          ],
          "properties": {
            "version": {
              "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/ProtocolVersion"
            },
            "type": { "const": "event" },
            "subscriptionId": {
              "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/SubscriptionId"
            },
            "stream": {
              "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/RunStream"
            },
            "cursor": {
              "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/Cursor"
            },
            "kind": { "const": "planner.event" },
            "occurredAt": { "type": "string", "format": "date-time" },
            "data": {
              "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/PlannerEventData"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "type",
            "subscriptionId",
            "stream",
            "cursor",
            "kind",
            "occurredAt",
            "data"
          ],
          "properties": {
            "version": {
              "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/ProtocolVersion"
            },
            "type": { "const": "event" },
            "subscriptionId": {
              "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/SubscriptionId"
            },
            "stream": {
              "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/RunStream"
            },
            "cursor": {
              "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/Cursor"
            },
            "kind": { "const": "lifecycle.changed" },
            "occurredAt": { "type": "string", "format": "date-time" },
            "data": {
              "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/LifecycleEventData"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "type",
            "subscriptionId",
            "stream",
            "cursor",
            "kind",
            "occurredAt",
            "data"
          ],
          "properties": {
            "version": {
              "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/ProtocolVersion"
            },
            "type": { "const": "event" },
            "subscriptionId": {
              "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/SubscriptionId"
            },
            "stream": {
              "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/OperationsStream"
            },
            "cursor": {
              "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/Cursor"
            },
            "kind": { "const": "operations.changed" },
            "occurredAt": { "type": "string", "format": "date-time" },
            "data": {
              "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/OperationsEventData"
            }
          }
        }
      ]
    },
    "ResyncRequiredFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "type", "subscriptionId", "stream", "reason"],
      "properties": {
        "version": {
          "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/ProtocolVersion"
        },
        "type": { "const": "resync_required" },
        "subscriptionId": {
          "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/SubscriptionId"
        },
        "stream": {
          "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/Stream"
        },
        "reason": {
          "enum": ["generation_changed", "cursor_unavailable", "sequence_gap"]
        }
      }
    },
    "ErrorFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "type", "code", "message", "retryable"],
      "properties": {
        "version": {
          "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/ProtocolVersion"
        },
        "type": { "const": "error" },
        "subscriptionId": {
          "$ref": "https://contractor.local/schemas/contractor-events-v1.schema.json#/$defs/SubscriptionId"
        },
        "code": {
          "enum": [
            "invalid_frame",
            "subscription_limit",
            "unauthorized",
            "not_found",
            "overloaded"
          ]
        },
        "message": { "type": "string", "minLength": 1, "maxLength": 512 },
        "retryable": { "type": "boolean" }
      }
    }
  }
}
