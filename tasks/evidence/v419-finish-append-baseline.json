  "findings": [
    "All12 accepted-finish rows return and durably record a candidate with nil error despite exactly one required final FunctionResponse append receiving a real PostgreSQL CHECK rejection or injected unavailable condition.",
    "Both ordinary pre-finish unavailable rows return and durably record planner_execution_failed, instead of the PLN-R106 session-unavailable class.",
    "Both ordinary pre-finish invalid rows correctly return planner_session_rejected with ErrInvalid; four cancellation controls correctly distinguish pre-finish caller cancellation from the independent completion write after successful final FunctionResponse."
  ],
  "contract": {
    "required_write": "PLN-R94/R105 require reduced nonpartial events to commit; PLN-R106 requires the owning session failure instead of a candidate, including redacted ADK events.",
    "receipt": "finish_requested stores only key/revision/outcome, not a full candidate. The in-memory completion is not completed-result recovery authority.",
    "recovery": "PLN-R107 forbids partial model resume; completed failure/candidate recovery must invoke neither model nor Worker.",
    "cancellation": "Independent CompleteSession uses context.WithoutCancel and its own finite budget. The passing controls must remain unchanged by repair."
  },
  "failure_source": {
    "invalid": "Test-schema event-specific PostgreSQL CHECK v419_required_event_rejected, selecting only the required modeled event. Its actual PgError/constraint and runstore.ErrInvalid are asserted.",
    "unavailable": "A test-schema event-specific trigger raises persistencepostgres.SQLStateConnectionFailure. This is an injected PostgreSQL SQLSTATE outage, not a real server/connection disruption.",
    "forwarder": "The production SessionService and Store execute every write. The transparent ADK forwarder only observes actual delegate results; it creates no storage failure."
  },
  "scope_limits": [
    "Actual pinned Runner and real PostgreSQL, scripted model and fake WorkerInvoker. No actual Gateway HTTP or Server/Runtime process conformance is claimed.",
    "No production file, dependency pin, Scheduler implementation or existing test expectation changed.",
    "No successful post-fix gate is claimed; full owner/race/lint gates remain required after repair.",
    "Task remains in_progress. Production edits wait for V418-007 completion and coordinator authorization."
  ],
  "minimal_fix_plan": [
    "Return an existing classified typed Planner session error (or an equivalent dedicated write-error wrapper preserving errors.Is/As) from the required ADK append boundary. Do not classify arbitrary SDK/model exceptions as storage outages.",
    "Check that required-write failure before accepting the in-memory terminal candidate; preserve failed-candidate retryability and record only the owning failure completion, without model/Worker replay.",
    "Keep genuine execution cancellation/deadline ownership and the independent completion-write budget separate; preserve the four passing cancellation controls.",
    "After repair, rerun the exact20 unchanged assertions, then full Planner/Scheduler owner suites, race, test-streamline and lint; later001/003 candidate characterization reuses these case IDs."
