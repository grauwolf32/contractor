  "new_regression_matrix": [
    {
      "case": "test_real_gateway_roles_preserve_schemas_reasoning_and_serialized_capture_policy",
      "parameter_cases": 6,
      "covers": [
        "A1",
        "A2",
        "A4"
      ],
      "proof": "Real main-tool-main-finalizer and main-tool-summary HTTP paths preserve literal braces, exact required/nullable/default schema, hidden context omission, main tools without output schema, tool-free strict terminal schemas and selected model aliases. Reasoning is captured only by authorized telemetry and never replayed to later model requests. Overlapping reasoning/completion tokens are charged once. Serialized protobuf enforces off/on/sensitive-forced-off content and excludes credentials, private Gateway configuration, collector headers and ignored envelope extensions. The global OTel provider is unchanged and only Contractor span names reach the controlled sink."
    },
    {
      "case": "test_actual_gateway_role_cancellation_joins_request_or_recovery_without_resend",
      "parameter_cases": 6,
      "covers": [
        "A3"
      ],
      "proof": "Main, finalizer and summary each cancel while awaiting an actual HTTP response or recovery authority. The request joins, no semantic resend follows, invocation ownership is released and closing clears each Gateway credential/client URL."
    },
    {
      "case": "test_actual_summary_gateway_keeps_strict_errors_and_spent_usage",
      "parameter_cases": 3,
      "covers": [
        "A2",
        "A3"
      ],
      "proof": "Actual summary HTTP length with malformed tool JSON rejects without execution; malformed tool JSON keeps its classified failure and known usage; omitted usage remains unavailable while a valid summary succeeds. Main and independent summary counters remain separate."
    },
    {
      "case": "test_actual_gateway_documents_last_duplicate_argument_and_ignores_envelope_extensions",
      "parameter_cases": 1,
      "covers": [
        "A2"
      ],
      "proof": "The existing provider JSON parser accepts extension fields and uses the last duplicate argument value. This characterizes current provider parsing and does not relax Contractor-owned strict result/wire models."
    },
    {
      "case": "test_actual_parallel_dispatch_preserves_self_recorded_correlation_for_every_error_path",
      "parameter_cases": 1,
      "covers": [
        "A5"
      ],
      "proof": "An actual five-call SDK batch includes self-recorded success/domain error under a concurrency barrier, infrastructure exception, raw admission rejection and unknown tool. Exactly five records/spans, unique call identities, bounded unknown_tool key, per-tool outcomes and State totals prove prepare/execute task ContextVar propagation avoids duplicate tool-owned accounting."
    },
    {
      "case": "test_native_skill_content_reaches_only_the_authorized_serialized_sink",
      "parameter_cases": 3,
      "covers": [
        "A4",
        "A5"
      ],
      "proof": "A test-only pseudo-Skill is loaded and its reference read through native SDK tools and the actual custom HTTP model. Skill instruction/reference contents reach serialized OTLP only with explicit ordinary capture; any selected sensitive tool suppresses them allocation-wide even without executing that tool. Extraction is removed on release."
    }
  ],
