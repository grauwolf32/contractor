# Build a static binary first; pass a prepared context containing that binary
# and your immutable operator/bootstrap configs. No build toolchain or /tmp is
# present in the final image. The CA bundle stage only supplies public roots
# for HTTPS Git imports (alpine:3.24).
FROM docker.io/library/alpine@sha256:294b683cb724975bec92580e1e685676bd4b50bda910ddb8c51d4cabeaec77e6 AS ca-certificates

FROM scratch
COPY --from=ca-certificates /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
COPY contractor-server /contractor-server
COPY configs /configs
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
ENTRYPOINT ["/contractor-server"]
