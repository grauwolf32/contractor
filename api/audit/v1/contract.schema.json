          "maxItems": 512,
          "uniqueItems": true
        }
      },
      "required": [
        "item_key",
        "rationale",
        "tested_conditions",
        "evidence",
        "limitations"
      ],
      "additionalProperties": false
    },
    "result_item": {
      "type": "object",
      "properties": {
        "item_key": {
          "$ref": "#/$defs/key"
        },
        "verdict": {
          "enum": [
            "supported",
            "refuted",
            "inconclusive"
          ]
        },
        "rationale": {
          "$ref": "#/$defs/text"
        },
        "tested_conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          },
          "maxItems": 256,
          "uniqueItems": true
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "x-maxUtf8Bytes": 512,
            "pattern": "[^\t\n\u000b\f\r \u0085\u00a0\u1680\u2000\u2001\u2002\u2003\u2004\u2005\u2006\u2007\u2008\u2009\u200a\u2028\u2029\u202f\u205f\u3000]"
          },
          "maxItems": 512,
          "uniqueItems": true
        },
        "origin": {
          "$ref": "#/$defs/origin"
        },
        "finding_receipts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource_id"
          },
          "maxItems": 128,
          "uniqueItems": true
        }
      },
      "required": [
        "item_key",
        "rationale",
        "tested_conditions",
        "evidence",
        "limitations",
        "origin"
      ],
      "additionalProperties": false
    },
    "conclusions": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "contractor.audit.conclusions.v1"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/conclusion_item"
          },
          "maxItems": 64,
          "minItems": 1
        }
      },
      "required": [
        "schema",
        "items"
      ],
      "additionalProperties": false
    },
    "result": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "contractor.audit.result.v1"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/result_item"
          },
          "maxItems": 64,
          "minItems": 1
        }
      },
      "required": [
        "schema",
        "items"
      ],
      "additionalProperties": false
    },
    "mutation": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "contractor.audit.mutation.v1"
        },
        "records": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/task"
              },
              {
                "$ref": "#/$defs/hypothesis"
              }
            ]
          },
          "maxItems": 128,
          "minItems": 1
        }
      },
      "required": [
        "schema",
        "records"
      ],
      "additionalProperties": false,
      "x-maxEncodedBytes": 1048576
    },
    "resource_id": {
      "$ref": "https://contractor.local/schema/v1alpha1/common.schema.json#/$defs/resourceId"
    },
    "control": {
