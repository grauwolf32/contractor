            "command": {
              "const": "start"
            },
            "to": {
              "const": "active"
            }
          }
        },
        {
          "properties": {
            "from": {
              "const": "active"
            },
            "command": {
              "const": "pause"
            },
            "to": {
              "const": "paused"
            }
          }
        },
        {
          "properties": {
            "from": {
              "const": "active"
            },
            "command": {
              "const": "deadline"
            },
            "to": {
              "const": "paused"
            }
          }
        },
        {
          "properties": {
            "from": {
              "const": "paused"
            },
            "command": {
              "const": "resume"
            },
            "to": {
              "const": "active"
            }
          }
        },
        {
          "properties": {
            "from": {
              "const": "active"
            },
            "command": {
              "const": "cancel"
            },
            "to": {
              "const": "cancelling"
            }
          }
        },
        {
          "properties": {
            "from": {
              "const": "paused"
            },
            "command": {
              "const": "cancel"
            },
            "to": {
              "const": "cancelling"
            }
          }
        },
        {
          "properties": {
            "from": {
              "const": "finalizing"
            },
            "command": {
              "const": "cancel"
            },
            "to": {
              "const": "cancelling"
            }
          }
        },
        {
          "properties": {
            "from": {
              "const": "draft"
            },
            "command": {
              "const": "delete"
            },
            "to": {
              "const": "deleting"
            }
          }
        },
        {
          "properties": {
            "from": {
              "const": "completed"
