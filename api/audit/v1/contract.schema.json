            "$ref": "#/$defs/resource_id"
          },
          "maxItems": 128,
          "uniqueItems": true
        },
        "objective": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "item_key",
        "task_id",
        "evidence",
        "objective"
      ],
      "additionalProperties": false
    },
    "context": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "contractor.audit.context.v1"
        },
        "audit_id": {
          "$ref": "#/$defs/resource_id"
        },
        "run_id": {
          "$ref": "#/$defs/resource_id"
        },
        "workflow_ref": {
          "$ref": "https://contractor.local/schema/v1alpha1/common.schema.json#/$defs/selector",
          "maxLength": 193
        },
        "workflow_digest": {
          "$ref": "#/$defs/digest"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/member"
          },
          "maxItems": 64,
          "minItems": 1
        }
      },
      "required": [
        "schema",
        "audit_id",
        "run_id",
        "workflow_ref",
        "workflow_digest",
        "items"
      ],
      "additionalProperties": false
    },
    "origin": {
      "type": "object",
      "properties": {
        "audit_id": {
          "$ref": "#/$defs/resource_id"
        },
        "task_id": {
          "$ref": "#/$defs/resource_id"
        },
        "run_id": {
          "$ref": "#/$defs/resource_id"
        },
        "hypothesis": {
          "$ref": "#/$defs/hypothesis_ref"
        }
      },
      "required": [
        "audit_id",
        "task_id",
        "run_id"
      ],
      "additionalProperties": false
    },
