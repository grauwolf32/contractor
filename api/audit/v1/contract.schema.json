        "from",
        "command",
        "to"
      ],
      "properties": {
        "schema": {
          "const": "contractor.audit.control.v1"
        },
        "from": {
          "type": "string"
        },
        "command": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      },
      "oneOf": [
        {
          "properties": {
            "from": {
              "const": "draft"
