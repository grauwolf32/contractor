{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:contractor:audit:v1",
  "oneOf": [
    {
      "$ref": "#/$defs/program"
    },
    {
      "$ref": "#/$defs/hypothesis"
    },
    {
      "$ref": "#/$defs/task"
    },
    {
      "$ref": "#/$defs/context"
    },
    {
      "$ref": "#/$defs/conclusions"
    },
    {
      "$ref": "#/$defs/result"
    },
    {
      "$ref": "#/$defs/mutation"
    },
    {
      "$ref": "#/$defs/control"
    },
    {
      "$ref": "#/$defs/proposals"
    },
    {
      "$ref": "#/$defs/proposal_context"
    }
  ],
  "$defs": {
    "key": {
      "$ref": "https://contractor.local/schema/v1alpha1/common.schema.json#/$defs/name"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "pattern": "[^\t\n\u000b\f\r \u0085\u00a0\u1680\u2000\u2001\u2002\u2003\u2004\u2005\u2006\u2007\u2008\u2009\u200a\u2028\u2029\u202f\u205f\u3000]",
      "x-maxUtf8Bytes": 65536
    },
    "digest": {
      "$ref": "https://contractor.local/schema/v1alpha1/common.schema.json#/$defs/digest"
    },
    "hypothesis_ref": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/resource_id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "revision"
      ],
      "additionalProperties": false
    },
    "ref": {
      "$ref": "https://contractor.local/schema/v1alpha1/common.schema.json#/$defs/exactArtifactRef"
    },
    "artifact": {
      "type": "object",
      "properties": {
        "scope_kind": {
          "enum": [
            "audit",
            "project",
            "run"
          ]
        },
        "scope_id": {
          "$ref": "#/$defs/resource_id"
        },
        "ref": {
          "$ref": "#/$defs/ref"
        },
        "digest": {
          "$ref": "#/$defs/digest"
        },
        "media_type": {
          "$ref": "https://contractor.local/schema/v1alpha1/common.schema.json#/$defs/mediaType"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864
        }
      },
      "required": [
        "scope_kind",
        "scope_id",
        "ref",
        "digest",
        "media_type",
        "size_bytes"
      ],
      "additionalProperties": false
    },
    "seed": {
      "type": "object",
      "description": "The complete seed's RFC 8785 canonical UTF-8 encoding must fit 32768 bytes. This early content bound does not replace the complete hypothesis document bound after trusted identity, revision and origin are assigned.",
      "x-maxCanonicalBytes": 32768,
      "properties": {
        "statement": {
          "$ref": "#/$defs/text"
        },
        "scope": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/key"
          },
          "additionalProperties": {
            "$ref": "#/$defs/text"
          },
          "maxProperties": 64
        },
        "grounds": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "statement",
        "scope",
        "grounds"
      ],
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "properties": {
        "required": {
          "type": "boolean"
        },
        "media_types": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "https://contractor.local/schema/v1alpha1/common.schema.json#/$defs/mediaType"
              },
              {
                "const": "*/*"
              }
            ]
          },
          "maxItems": 16,
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "required",
        "media_types"
      ],
      "additionalProperties": false
    },
    "input_mapping": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "source": {
              "const": "audit-input"
            },
            "name": {
              "$ref": "#/$defs/key"
            }
          },
          "required": [
            "source",
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "source": {
              "enum": [
                "task-context",
                "prior-results"
              ]
            }
          },
          "required": [
            "source"
          ],
          "additionalProperties": false
        }
      ]
    },
    "workflow": {
      "type": "object",
      "properties": {
        "ref": {
          "$ref": "https://contractor.local/schema/v1alpha1/common.schema.json#/$defs/selector",
          "maxLength": 193
        },
        "inputs": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/key"
          },
          "additionalProperties": {
            "$ref": "#/$defs/input_mapping"
          },
          "maxProperties": 128
        },
        "parameters": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/key"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 4096,
            "x-maxUtf8Bytes": 4096
          },
          "maxProperties": 128
        },
        "outputs": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/key"
          },
          "additionalProperties": {
            "$ref": "#/$defs/key"
          },
          "maxProperties": 128
        }
      },
      "required": [
        "ref",
        "inputs",
        "parameters",
        "outputs"
      ],
      "additionalProperties": false
    },
    "initial": {
      "type": "object",
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "workflow": {
          "$ref": "#/$defs/key"
        },
        "objective": {
          "$ref": "#/$defs/text"
        },
        "hypothesis": {
          "$ref": "#/$defs/key"
        },
        "inputs": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/key"
          },
          "additionalProperties": {
            "$ref": "#/$defs/key"
          },
          "maxProperties": 32
        }
      },
      "required": [
        "key",
        "workflow",
        "objective"
      ],
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_tasks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "max_iterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "max_tasks_per_iteration": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "batch_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "max_submitted_runs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "deadline_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 31536000
        },
        "max_evidence_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "max_hypotheses": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "max_hypothesis_revisions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50000
        },
        "max_hypothesis_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        }
      },
      "required": [
        "max_tasks",
        "max_iterations",
        "max_tasks_per_iteration",
        "batch_size",
        "max_submitted_runs",
        "max_attempts",
        "deadline_seconds",
        "max_evidence_bytes",
        "max_hypotheses",
        "max_hypothesis_revisions",
        "max_hypothesis_bytes"
      ],
      "additionalProperties": false
    },
    "program": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "contractor.audit.program.v1"
        },
        "inputs": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/key"
          },
          "additionalProperties": {
            "$ref": "#/$defs/input"
          },
          "maxProperties": 32
        },
        "workflows": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/key"
          },
          "additionalProperties": {
            "$ref": "#/$defs/workflow"
          },
          "maxProperties": 16,
          "minProperties": 1
        },
        "hypotheses": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/key"
          },
          "additionalProperties": {
            "$ref": "#/$defs/seed"
          },
          "maxProperties": 10000
        },
        "initial_work": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/initial"
          },
          "maxItems": 10000,
          "minItems": 1
        },
        "continuation": {
          "type": "object",
          "properties": {
            "workflow": {
              "$ref": "#/$defs/key"
            }
          },
          "required": [
            "workflow"
          ],
          "additionalProperties": false
        },
        "limits": {
          "$ref": "#/$defs/limits"
        },
        "policy": {
          "type": "object",
          "properties": {
            "active_operations": {
              "enum": [
                "allowed",
                "prohibited"
              ]
            }
          },
          "required": [
            "active_operations"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schema",
        "inputs",
        "workflows",
        "hypotheses",
        "initial_work",
        "limits",
        "policy"
      ],
      "additionalProperties": false,
      "x-maxEncodedBytes": 4194304
    },
    "hypothesis": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "contractor.audit.hypothesis.v1"
        },
        "id": {
          "$ref": "#/$defs/resource_id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "statement": {
          "$ref": "#/$defs/text"
        },
        "scope": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/key"
          },
          "additionalProperties": {
            "$ref": "#/$defs/text"
          },
          "maxProperties": 64
        },
        "grounds": {
          "$ref": "#/$defs/text"
        },
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "audit_id"
          ],
          "properties": {
            "kind": {
              "enum": [
                "manual",
                "checklist",
                "run"
              ]
            },
            "audit_id": {
              "$ref": "#/$defs/resource_id"
            },
            "task_id": {
              "$ref": "#/$defs/resource_id"
            },
            "run_id": {
              "$ref": "#/$defs/resource_id"
            },
            "source": {
              "$ref": "#/$defs/artifact"
            }
          },
          "oneOf": [
            {
              "properties": {
                "kind": {
                  "const": "run"
                }
              },
              "required": [
                "task_id",
                "run_id"
              ]
            },
            {
              "properties": {
                "kind": {
                  "enum": [
                    "manual",
                    "checklist"
                  ]
                }
              },
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "task_id"
                    ]
                  },
                  {
                    "required": [
                      "run_id"
                    ]
                  }
                ]
              }
            }
          ]
        }
      },
      "required": [
        "schema",
        "id",
        "revision",
        "statement",
        "scope",
        "grounds",
        "origin"
      ],
      "additionalProperties": false,
      "x-maxEncodedBytes": 32768
    },
    "task": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "contractor.audit.task.v1"
        },
        "audit_id": {
          "$ref": "#/$defs/resource_id"
        },
        "task_id": {
          "$ref": "#/$defs/resource_id"
        },
        "workflow": {
          "$ref": "#/$defs/key"
        },
        "inputs": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/key"
          },
          "additionalProperties": {
            "$ref": "#/$defs/artifact"
          },
          "maxProperties": 32
        },
        "parameters": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/key"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 4096,
            "x-maxUtf8Bytes": 4096
          },
          "maxProperties": 128
        },
        "hypothesis": {
          "$ref": "#/$defs/hypothesis_ref"
        },
        "objective": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "schema",
        "audit_id",
        "task_id",
        "workflow",
        "inputs",
        "parameters",
        "objective"
      ],
      "additionalProperties": false
    },
    "member": {
      "type": "object",
      "properties": {
        "item_key": {
          "$ref": "#/$defs/key"
        },
        "task_id": {
          "$ref": "#/$defs/resource_id"
        },
        "hypothesis": {
          "$ref": "#/$defs/hypothesis"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          },
          "maxItems": 256,
          "uniqueItems": true
        },
        "finding_receipts": {
          "type": "array",
