{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractor.local/schema/v1alpha1/planner-execution.schema.json",
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "parameters"
      ],
      "properties": {
        "name": {
          "$ref": "common.schema.json#/$defs/name"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object"
        }
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "tools"
      ],
      "properties": {
        "input": {
          "type": "string",
          "minLength": 1
        },
        "tools": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/tool"
          }
        },
        "compaction": {
          "$ref": "#/$defs/compaction"
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "sequence",
        "name",
        "arguments"
      ],
      "properties": {
        "apiVersion": {
          "$ref": "common.schema.json#/$defs/apiVersion"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5001
        },
        "name": {
          "$ref": "common.schema.json#/$defs/name"
        },
        "arguments": {
          "type": "object"
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "apiVersion",
        "result",
        "stop",
        "escalate"
      ],
      "properties": {
        "apiVersion": {
          "$ref": "common.schema.json#/$defs/apiVersion"
        },
        "result": {
          "type": "object"
        },
        "stop": {
          "type": "boolean"
        },
        "escalate": {
          "type": "boolean"
        },
        "failure": {
          "$ref": "common.schema.json#/$defs/terminationError"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "escalate": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "stop": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "compaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instructions",
        "threshold",
        "keepRecentGroups",
        "maxCompactions",
        "policy"
      ],
      "properties": {
        "instructions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "threshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "keepRecentGroups": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "maxCompactions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "policy": {
          "$ref": "common.schema.json#/$defs/workerCompactorModelPolicy"
        }
      }
    }
  }
}
