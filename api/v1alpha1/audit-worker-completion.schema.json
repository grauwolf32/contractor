{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractor.local/schema/v1alpha1/audit-worker-completion.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "stage",
    "agent"
  ],
  "properties": {
    "kind": {
      "const": "audit-check-results@1"
    },
    "stage": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "agent": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    }
  }
}
