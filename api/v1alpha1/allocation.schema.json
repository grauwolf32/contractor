{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractor.local/schema/v1alpha1/allocation.schema.json",
  "$defs": {
    "executionError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "retryable": {
          "type": "boolean"
        }
      }
    },
    "toolMetrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "calls": {
          "type": "integer",
          "minimum": 0
        },
        "succeeded": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "workerBudgetMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxModelCalls",
        "maxToolCalls",
        "maxTotalTokens",
        "observedModelCalls",
        "observedToolCalls",
        "observedTotalTokens",
        "tokenUsageUnavailable"
      ],
      "properties": {
        "maxModelCalls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "maxToolCalls": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "maxTotalTokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000000
        },
        "observedModelCalls": {
          "type": "integer",
          "minimum": 0
        },
        "observedToolCalls": {
          "type": "integer",
          "minimum": 0
        },
        "observedTotalTokens": {
          "type": "integer",
          "minimum": 0
        },
        "tokenUsageUnavailable": {
          "type": "integer",
          "minimum": 0
        },
        "exhausted": {
          "enum": [
            "model_calls",
            "tool_calls",
            "total_tokens"
          ]
        }
      }
    },
    "workerSummarizerMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempts",
        "succeeded",
        "failed",
        "modelCalls",
        "inputTokens",
        "outputTokens",
        "totalTokens",
        "tokenUsageUnavailable",
        "failureCodes"
      ],
      "properties": {
        "attempts": {
          "type": "integer",
          "minimum": 1
        },
        "succeeded": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "modelCalls": {
          "type": "integer",
          "minimum": 0
        },
        "inputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "totalTokens": {
          "type": "integer",
          "minimum": 0
        },
        "tokenUsageUnavailable": {
          "type": "integer",
          "minimum": 0
        },
        "failureCodes": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "executionMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tools"
      ],
      "properties": {
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "modelCalls": {
          "type": "integer",
          "minimum": 0
        },
        "inputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "totalTokens": {
          "type": "integer",
          "minimum": 0
        },
        "workerBudget": {
          "$ref": "#/$defs/workerBudgetMetrics"
        },
        "summarizer": {
          "$ref": "#/$defs/workerSummarizerMetrics"
        },
        "tools": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/toolMetrics"
          }
        }
      }
    },
    "toolCallRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "callId",
        "tool",
        "argumentsTruncated",
        "outcome"
      ],
      "properties": {
        "callId": {
          "$ref": "common.schema.json#/$defs/opaqueId"
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "arguments": {
          "type": "object"
        },
        "argumentsTruncated": {
          "type": "boolean"
        },
        "outcome": {
          "enum": [
            "succeeded",
            "failed"
          ]
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0
        },
        "resultSizeBytes": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "$ref": "#/$defs/executionError"
        }
      }
    },
    "workerCompletionDiagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "phase",
        "acceptedCount",
        "totalCount",
        "reminderCount"
      ],
      "properties": {
        "kind": {
          "const": "audit-check-results@1"
        },
        "phase": {
          "enum": [
            "collecting",
            "sealed",
            "publishing",
            "published",
            "failed"
          ]
        },
        "acceptedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 64
        },
        "totalCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "reminderCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "failureCode": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "phase": {
                "const": "failed"
              }
            }
          },
          "then": {
            "required": [
              "failureCode"
            ]
          },
          "else": {
            "not": {
              "required": [
                "failureCode"
              ]
            }
          }
        }
      ]
    },
    "executionReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reportId",
        "complete",
        "metrics",
        "toolCalls",
        "errors",
        "truncated"
      ],
      "properties": {
        "reportId": {
          "$ref": "common.schema.json#/$defs/opaqueId"
        },
        "complete": {
          "type": "boolean"
        },
        "metrics": {
          "$ref": "#/$defs/executionMetrics"
        },
        "completion": {
          "$ref": "#/$defs/workerCompletionDiagnostics"
        },
        "toolCalls": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/toolCallRecord"
          }
        },
        "errors": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/executionError"
          }
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "runtimeReport": {
      "$ref": "runtime-report.schema.json"
    },
    "allocationFinalReport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reportId",
        "allocationId",
        "startedAt",
        "finishedAt",
        "worker",
        "runtime"
      ],
      "properties": {
        "reportId": {
          "$ref": "common.schema.json#/$defs/opaqueId"
        },
        "allocationId": {
          "$ref": "common.schema.json#/$defs/opaqueId"
        },
        "startedAt": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "finishedAt": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "worker": {
          "$ref": "#/$defs/executionReport"
        },
        "runtime": {
          "$ref": "#/$defs/runtimeReport"
        }
      }
    },
    "runMetadataLabels": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "allOf": [
          {
            "minLength": 1,
            "maxLength": 63
          },
          {
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
          },
          {
            "not": {
              "pattern": "^contractor\\."
            }
          }
        ]
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 0,
        "maxLength": 256,
        "pattern": "^[^\\u0000]*$"
      }
    },
    "allocationSpec": {
      "additionalProperties": false,
      "properties": {
        "apiVersion": {
          "$ref": "common.schema.json#/$defs/apiVersion"
        },
        "completionContract": {
          "$ref": "worker-completion-contract.schema.json"
        },
        "allocationId": {
          "$ref": "common.schema.json#/$defs/opaqueId"
        },
        "runId": {
          "$ref": "common.schema.json#/$defs/opaqueId"
        },
        "stageExecutionId": {
          "$ref": "common.schema.json#/$defs/opaqueId"
        },
        "logicalAgentName": {
          "$ref": "common.schema.json#/$defs/opaqueId"
        },
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "not": {
            "pattern": "[^A-Za-z0-9_.-]"
          }
        },
        "workerSessionMode": {
          "enum": [
            "isolated",
            "shared"
          ]
        },
        "runMetadataLabels": {
          "$ref": "#/$defs/runMetadataLabels"
        },
        "leaseExpiresAt": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "agentTemplate": {
          "$ref": "common.schema.json#/$defs/resolvedAgentTemplate"
        },
        "resolvedSkills": {
          "items": {
            "$ref": "#/$defs/ResolvedSkill"
          },
          "maxItems": 32,
          "title": "Resolvedskills",
          "type": "array",
          "uniqueItems": true
        },
        "modelPolicy": {
          "$ref": "common.schema.json#/$defs/resolvedModelPolicy"
        },
        "runtimeSettings": {
          "$ref": "#/$defs/RuntimeSettings"
        },
        "resolvedRuntimeConfigProvenance": {
          "$ref": "#/$defs/ResolvedRuntimeConfigProvenance"
        },
        "workspace": {
          "anyOf": [
            {
              "$ref": "#/$defs/AllocationWorkspaceSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "performanceMetrics": {
          "anyOf": [
            {
              "$ref": "#/$defs/PerformanceMetricsRequest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "apiVersion",
        "allocationId",
        "runId",
        "stageExecutionId",
        "logicalAgentName",
        "namespace",
        "workerSessionMode",
        "runMetadataLabels",
        "leaseExpiresAt",
        "agentTemplate",
        "resolvedSkills",
        "modelPolicy",
        "runtimeSettings",
        "resolvedRuntimeConfigProvenance"
      ],
      "title": "AllocationSpec",
      "type": "object"
    },
    "AllocationWorkspaceExport": {
      "additionalProperties": false,
      "properties": {
        "state": {
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "State",
          "type": "string"
        },
        "diff": {
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Diff",
          "type": "string"
        }
      },
      "required": [
        "state",
        "diff"
      ],
      "title": "AllocationWorkspaceExport",
      "type": "object"
    },
    "AllocationWorkspaceSource": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        },
        "target": {
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "artifact",
        "target"
      ],
      "title": "AllocationWorkspaceSource",
      "type": "object"
    },
    "AllocationWorkspaceSpec": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "direct",
            "overlay"
          ],
          "title": "Mode",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/AllocationWorkspaceSource"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        },
        "state": {
          "anyOf": [
            {
              "$ref": "#/$defs/AllocationWorkspaceState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "export": {
          "anyOf": [
            {
              "$ref": "#/$defs/AllocationWorkspaceExport"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "mode",
        "sources"
      ],
      "title": "AllocationWorkspaceSpec",
      "type": "object"
    },
    "AllocationWorkspaceState": {
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "$ref": "#/$defs/ArtifactRef"
        }
      },
      "required": [
        "artifact"
      ],
      "title": "AllocationWorkspaceState",
      "type": "object"
    },
    "ArtifactRef": {
      "$ref": "common.schema.json#/$defs/artifactRef"
    },
    "CaidoSettings": {
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "title": "Adapter",
          "type": "string"
        },
        "endpoint": {
          "title": "Endpoint",
          "type": "string"
        },
        "bearerToken": {
          "anyOf": [
            {
              "format": "password",
              "type": "string",
              "writeOnly": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bearertoken"
        },
        "caBundlePem": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cabundlepem"
        },
        "requestTimeoutSeconds": {
          "title": "Requesttimeoutseconds",
          "type": "integer"
        }
      },
      "required": [
        "adapter",
        "endpoint",
        "requestTimeoutSeconds"
      ],
      "title": "CaidoSettings",
      "type": "object"
    },
    "HTTPOriginTargetSettings": {
      "additionalProperties": false,
      "properties": {
        "url": {
          "title": "Url",
          "type": "string"
        },
        "basicAuth": {
          "anyOf": [
            {
              "$ref": "#/$defs/HTTPProxyBasicAuth"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "bearerToken": {
          "anyOf": [
            {
              "format": "password",
              "type": "string",
              "writeOnly": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bearertoken"
        }
      },
      "required": [
        "url"
      ],
      "title": "HTTPOriginTargetSettings",
      "type": "object"
    },
    "HTTPProxyBasicAuth": {
      "additionalProperties": false,
      "properties": {
        "username": {
          "format": "password",
          "title": "Username",
          "type": "string",
          "writeOnly": true
        },
        "password": {
          "format": "password",
          "title": "Password",
          "type": "string",
          "writeOnly": true
        }
      },
      "required": [
        "username",
        "password"
      ],
      "title": "HTTPProxyBasicAuth",
      "type": "object"
    },
    "HTTPProxySettings": {
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "title": "Adapter",
          "type": "string"
        },
        "proxyUrl": {
          "title": "Proxyurl",
          "type": "string"
        },
        "basicAuth": {
          "anyOf": [
            {
              "$ref": "#/$defs/HTTPProxyBasicAuth"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "bearerToken": {
          "anyOf": [
            {
              "format": "password",
              "type": "string",
              "writeOnly": true
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bearertoken"
        },
        "caBundlePem": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cabundlepem"
        },
        "targets": {
          "items": {
            "enum": [
              "llm-gateway",
              "tool-http",
              "tool-subprocess"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Targets",
          "type": "array"
        }
      },
      "required": [
        "adapter",
        "proxyUrl",
        "targets"
      ],
      "title": "HTTPProxySettings",
      "type": "object"
    },
    "LLMCredentialRef": {
      "additionalProperties": false,
      "properties": {
        "credentialId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Credentialid",
          "type": "string"
        }
      },
      "required": [
        "credentialId"
      ],
      "title": "LLMCredentialRef",
      "type": "object"
    },
    "LLMGatewayConfigRef": {
      "additionalProperties": false,
      "properties": {
        "gatewayId": {
          "title": "Gatewayid",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "digest": {
          "title": "Digest",
          "type": "string"
        }
      },
      "required": [
        "gatewayId",
        "version",
        "digest"
      ],
      "title": "LLMGatewayConfigRef",
      "type": "object"
    },
    "PerformanceMetricsRequest": {
      "$ref": "performance.schema.json#/$defs/performanceMetricsRequest"
    },
    "ResolvedRuntimeConfigProvenance": {
      "additionalProperties": false,
      "properties": {
        "default": {
          "$ref": "#/$defs/RuntimeLabelBindingProvenance"
        },
        "runLabels": {
          "items": {
            "$ref": "#/$defs/RuntimeLabelBindingProvenance"
          },
          "maxItems": 32,
          "title": "Runlabels",
          "type": "array"
        },
        "agentLabels": {
          "items": {
            "$ref": "#/$defs/RuntimeLabelBindingProvenance"
          },
          "maxItems": 32,
          "title": "Agentlabels",
          "type": "array"
        },
        "runtimeAdapters": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Runtimeadapters",
          "type": "array"
        },
        "llmGatewayConfig": {
          "anyOf": [
            {
              "$ref": "#/$defs/LLMGatewayConfigRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "llmCredential": {
          "anyOf": [
            {
              "$ref": "#/$defs/LLMCredentialRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "runtimeCredentialRefs": {
          "items": {
            "$ref": "#/$defs/RuntimeCredentialRef"
          },
          "maxItems": 64,
          "title": "Runtimecredentialrefs",
          "type": "array"
        }
      },
      "required": [
        "default",
        "runLabels",
        "agentLabels",
        "runtimeAdapters",
        "runtimeCredentialRefs"
      ],
      "title": "ResolvedRuntimeConfigProvenance",
      "type": "object"
    },
    "ResolvedSkill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "artifact",
        "packageDigest"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "namespace",
            "name",
            "revision"
          ],
          "properties": {
            "namespace": {
              "const": "skills"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "revision": {
              "$ref": "common.schema.json#/$defs/opaqueId"
            }
          }
        },
        "packageDigest": {
          "$ref": "common.schema.json#/$defs/digest"
        }
      }
    },
    "RuntimeConfigRef": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "digest": {
          "title": "Digest",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "digest"
      ],
      "title": "RuntimeConfigRef",
      "type": "object"
    },
    "RuntimeCredentialRef": {
      "additionalProperties": false,
      "properties": {
        "credentialId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "title": "Credentialid",
          "type": "string"
        },
        "kind": {
          "enum": [
            "caido-bearer@1",
            "http-origin-basic@1",
            "http-origin-bearer@1",
            "http-proxy-basic@1",
            "http-proxy-bearer@1",
            "otlp-headers@1"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "credentialId",
        "kind"
      ],
      "title": "RuntimeCredentialRef",
      "type": "object"
    },
    "RuntimeLabelBindingProvenance": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "bindingRevision": {
          "exclusiveMinimum": 0,
          "maximum": 18446744073709551615,
          "title": "Bindingrevision",
          "type": "integer"
        },
        "config": {
          "$ref": "#/$defs/RuntimeConfigRef"
        }
      },
      "required": [
        "label",
        "bindingRevision",
        "config"
      ],
      "title": "RuntimeLabelBindingProvenance",
      "type": "object"
    },
    "RuntimeSettings": {
      "additionalProperties": false,
      "properties": {
        "llmGatewayUrl": {
          "title": "Llmgatewayurl",
          "type": "string"
        },
        "llmGatewayToken": {
          "anyOf": [
            {
