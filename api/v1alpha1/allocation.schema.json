{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractor.local/schema/v1alpha1/allocation.schema.json",
  "$defs": {
    "executionError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1, "maxLength": 4096},
        "retryable": {"type": "boolean"}
      }
    },
    "toolMetrics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "calls": {"type": "integer", "minimum": 0},
        "succeeded": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0}
      }
    },
    "workerBudgetMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxModelCalls", "maxToolCalls", "maxTotalTokens", "observedModelCalls", "observedToolCalls", "observedTotalTokens", "tokenUsageUnavailable"],
      "properties": {
        "maxModelCalls": {"type": "integer", "minimum": 1, "maximum": 1000},
        "maxToolCalls": {"type": "integer", "minimum": 1, "maximum": 10000},
        "maxTotalTokens": {"type": "integer", "minimum": 1, "maximum": 100000000},
        "observedModelCalls": {"type": "integer", "minimum": 0},
        "observedToolCalls": {"type": "integer", "minimum": 0},
        "observedTotalTokens": {"type": "integer", "minimum": 0},
        "tokenUsageUnavailable": {"type": "integer", "minimum": 0},
        "exhausted": {"enum": ["model_calls", "tool_calls", "total_tokens"]}
      }
    },
    "workerSummarizerMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempts", "succeeded", "failed", "modelCalls", "inputTokens", "outputTokens", "totalTokens", "tokenUsageUnavailable", "failureCodes"],
      "properties": {
        "attempts": {"type": "integer", "minimum": 1},
        "succeeded": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "modelCalls": {"type": "integer", "minimum": 0},
        "inputTokens": {"type": "integer", "minimum": 0},
        "outputTokens": {"type": "integer", "minimum": 0},
        "totalTokens": {"type": "integer", "minimum": 0},
        "tokenUsageUnavailable": {"type": "integer", "minimum": 0},
        "failureCodes": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {"minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9_]{0,63}$"},
          "additionalProperties": {"type": "integer", "minimum": 1}
        }
      }
    },
    "executionMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tools"],
      "properties": {
        "durationMs": {"type": "integer", "minimum": 0},
        "modelCalls": {"type": "integer", "minimum": 0},
        "inputTokens": {"type": "integer", "minimum": 0},
        "outputTokens": {"type": "integer", "minimum": 0},
        "totalTokens": {"type": "integer", "minimum": 0},
        "workerBudget": {"$ref": "#/$defs/workerBudgetMetrics"},
        "summarizer": {"$ref": "#/$defs/workerSummarizerMetrics"},
        "tools": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/toolMetrics"}
        }
      }
    },
    "toolCallRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["callId", "tool", "argumentsTruncated", "outcome"],
      "properties": {
        "callId": {"$ref": "common.schema.json#/$defs/opaqueId"},
        "tool": {"type": "string", "minLength": 1},
        "arguments": {"type": "object"},
        "argumentsTruncated": {"type": "boolean"},
        "outcome": {"enum": ["succeeded", "failed"]},
        "durationMs": {"type": "integer", "minimum": 0},
        "resultSizeBytes": {"type": "integer", "minimum": 0},
        "error": {"$ref": "#/$defs/executionError"}
      }
    },
    "workerCompletionDiagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "phase", "acceptedCount", "totalCount", "reminderCount"],
      "properties": {
        "kind": {"const": "audit-check-results@1"},
        "phase": {"enum": ["collecting", "sealed", "publishing", "published", "failed"]},
        "acceptedCount": {"type": "integer", "minimum": 0, "maximum": 64},
        "totalCount": {"type": "integer", "minimum": 1, "maximum": 64},
        "reminderCount": {"type": "integer", "minimum": 0, "maximum": 2},
        "failureCode": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}
      },
      "allOf": [{
        "if": {"properties": {"phase": {"const": "failed"}}},
        "then": {"required": ["failureCode"]},
        "else": {"not": {"required": ["failureCode"]}}
      }]
    },
    "executionReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reportId", "complete", "metrics", "toolCalls", "errors", "truncated"],
      "properties": {
        "reportId": {"$ref": "common.schema.json#/$defs/opaqueId"},
        "complete": {"type": "boolean"},
        "metrics": {"$ref": "#/$defs/executionMetrics"},
        "completion": {"$ref": "#/$defs/workerCompletionDiagnostics"},
        "toolCalls": {
          "type": "array",
          "maxItems": 1000,
          "items": {"$ref": "#/$defs/toolCallRecord"}
        },
        "errors": {
          "type": "array",
          "maxItems": 100,
          "items": {"$ref": "#/$defs/executionError"}
        },
        "truncated": {"type": "boolean"}
      }
    },
    "runtimeReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complete", "adapters"],
      "properties": {
        "complete": {"type": "boolean"},
        "resources": {"$ref": "performance.schema.json#/$defs/runtimeResources"},
        "durationMs": {"type": "integer", "minimum": 0},
        "stopReason": {"type": "string", "minLength": 1},
        "adapters": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {"enum": ["http-proxy@1", "otlp-http@1"]},
          "additionalProperties": {"$ref": "#/$defs/runtimeAdapterMetrics"}
        }
      }
    },
    "runtimeAdapterMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operations", "failedOperations"],
      "properties": {
        "operations": {"type": "integer", "minimum": 0},
        "failedOperations": {"type": "integer", "minimum": 0},
        "flushAttempted": {"type": "boolean"},
        "flushSucceeded": {"type": "boolean"},
        "lastErrorCode": {
          "enum": [
            "close_failed",
            "delivery_failed",
            "flush_failed",
            "flush_timeout",
            "queue_overflow",
            "request_failed"
          ]
        }
      }
    },
    "allocationFinalReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reportId", "allocationId", "startedAt", "finishedAt", "worker", "runtime"],
      "properties": {
        "reportId": {"$ref": "common.schema.json#/$defs/opaqueId"},
        "allocationId": {"$ref": "common.schema.json#/$defs/opaqueId"},
        "startedAt": {"$ref": "common.schema.json#/$defs/timestamp"},
        "finishedAt": {"$ref": "common.schema.json#/$defs/timestamp"},
        "worker": {"$ref": "#/$defs/executionReport"},
        "runtime": {"$ref": "#/$defs/runtimeReport"}
      }
    },
    "resolvedSkill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "artifact", "packageDigest"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "required": ["namespace", "name", "revision"],
          "properties": {
            "namespace": {"const": "skills"},
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            },
            "revision": {"$ref": "common.schema.json#/$defs/opaqueId"}
          }
        },
        "packageDigest": {"$ref": "common.schema.json#/$defs/digest"}
      }
    },
    "runMetadataLabels": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "allOf": [
          {"minLength": 1, "maxLength": 63},
          {"pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
          {"not": {"pattern": "^contractor\\."}}
        ]
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 0,
        "maxLength": 256,
        "pattern": "^[^\\u0000]*$"
      }
    },
    "allocationSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "allocationId", "runId", "stageExecutionId", "logicalAgentName", "namespace", "workerSessionMode", "runMetadataLabels", "leaseExpiresAt", "agentTemplate", "resolvedSkills", "modelPolicy", "runtimeSettings"],
      "properties": {
        "apiVersion": {"$ref": "common.schema.json#/$defs/apiVersion"},
        "allocationId": {"$ref": "common.schema.json#/$defs/opaqueId"},
        "runId": {"$ref": "common.schema.json#/$defs/opaqueId"},
        "stageExecutionId": {"$ref": "common.schema.json#/$defs/opaqueId"},
        "logicalAgentName": {"$ref": "common.schema.json#/$defs/opaqueId"},
        "namespace": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$", "not": {"pattern": "[^A-Za-z0-9_.-]"}},
        "workerSessionMode": {"enum": ["isolated", "shared"]},
        "runMetadataLabels": {"$ref": "#/$defs/runMetadataLabels"},
        "leaseExpiresAt": {"$ref": "common.schema.json#/$defs/timestamp"},
        "agentTemplate": {"$ref": "common.schema.json#/$defs/resolvedAgentTemplate"},
        "resolvedSkills": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/resolvedSkill"}
        },
        "modelPolicy": {"$ref": "common.schema.json#/$defs/resolvedModelPolicy"},
        "completionContract": {"$ref": "worker-completion-contract.schema.json"},
        "runtimeSettings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["llmGatewayUrl", "llmGatewayToken", "artifactApiUrl", "requestTimeoutSeconds"],
          "properties": {
            "llmGatewayUrl": {"type": "string", "format": "uri", "pattern": "^https?://"},
            "llmGatewayToken": {"type": "string"},
            "artifactApiUrl": {"type": "string", "format": "uri", "pattern": "^https?://"},
            "requestTimeoutSeconds": {"type": "integer", "minimum": 1}
          }
        }
      }
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/allocationSpec"},
    {
      "title": "PrepareAllocationRequest",
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "spec"],
      "properties": {"apiVersion": {"$ref": "common.schema.json#/$defs/apiVersion"}, "spec": {"$ref": "#/$defs/allocationSpec"}}
    },
    {
      "title": "FinalizeAllocationRequest",
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "allocationId", "finalizationId", "deadline"],
      "properties": {
        "apiVersion": {"$ref": "common.schema.json#/$defs/apiVersion"},
        "allocationId": {"$ref": "common.schema.json#/$defs/opaqueId"},
        "finalizationId": {"$ref": "common.schema.json#/$defs/opaqueId"},
        "deadline": {"$ref": "common.schema.json#/$defs/timestamp"}
      }
    },
    {
      "title": "AbortAllocationRequest",
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "allocationId", "abortId", "reason", "deadline"],
      "properties": {
        "apiVersion": {"$ref": "common.schema.json#/$defs/apiVersion"},
        "allocationId": {"$ref": "common.schema.json#/$defs/opaqueId"},
        "abortId": {"$ref": "common.schema.json#/$defs/opaqueId"},
        "reason": {"$ref": "common.schema.json#/$defs/terminationError"},
        "deadline": {"$ref": "common.schema.json#/$defs/timestamp"}
      }
    },
    {
      "title": "ReleaseAllocationRequest",
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "allocationId"],
      "properties": {
        "apiVersion": {"$ref": "common.schema.json#/$defs/apiVersion"},
        "allocationId": {"$ref": "common.schema.json#/$defs/opaqueId"}
      }
    },
    {
      "title": "AllocationFinalResponse",
      "type": "object",
      "additionalProperties": false,
      "required": ["apiVersion", "report"],
      "properties": {
        "apiVersion": {"$ref": "common.schema.json#/$defs/apiVersion"},
        "report": {"$ref": "#/$defs/allocationFinalReport"}
      }
    }
  ]
}
