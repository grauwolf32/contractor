{
  "$defs": {
    "RuntimeCompletionCapabilities": {
      "additionalProperties": false,
      "properties": {
        "completionContracts": {
          "items": {
            "const": "audit-check-results@1",
            "type": "string"
          },
          "maxItems": 1,
          "title": "Completioncontracts",
          "type": "array"
        }
      },
      "required": [
        "completionContracts"
      ],
      "title": "RuntimeCompletionCapabilities",
      "type": "object"
    },
    "WorkspaceCapabilities": {
      "additionalProperties": false,
      "properties": {
        "storage": {
          "enum": [
            "local",
            "memory"
          ],
          "title": "Storage",
          "type": "string"
        },
        "modes": {
          "items": {
            "enum": [
              "direct",
              "overlay"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Modes",
          "type": "array"
        },
        "limits": {
          "$ref": "#/$defs/WorkspaceLimits"
        }
      },
      "required": [
        "storage",
        "modes",
        "limits"
      ],
      "title": "WorkspaceCapabilities",
      "type": "object"
    },
    "WorkspaceLimits": {
      "additionalProperties": false,
      "properties": {
        "maxFiles": {
          "exclusiveMinimum": 0,
          "title": "Maxfiles",
          "type": "integer"
        },
        "maxExpandedBytes": {
          "exclusiveMinimum": 0,
          "title": "Maxexpandedbytes",
          "type": "integer"
        },
        "maxManagedTextBytes": {
          "exclusiveMinimum": 0,
          "title": "Maxmanagedtextbytes",
          "type": "integer"
        },
        "maxFileBytes": {
          "exclusiveMinimum": 0,
          "title": "Maxfilebytes",
          "type": "integer"
        }
      },
      "required": [
        "maxFiles",
        "maxExpandedBytes",
        "maxManagedTextBytes",
        "maxFileBytes"
      ],
      "title": "WorkspaceLimits",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "$ref": "common.schema.json#/$defs/apiVersion"
    },
    "instanceId": {
      "$ref": "common.schema.json#/$defs/opaqueId"
    },
    "softwareVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
    },
    "startedAt": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "controlUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "a2aUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https?://"
    },
    "supportedRuntimes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/selector"
      },
      "maxItems": 128
    },
    "supportedToolsets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "tools"
        ],
        "properties": {
          "ref": {
            "$ref": "common.schema.json#/$defs/selector"
          },
          "tools": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "maxItems": 128
    },
    "supportedSandboxProfiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "common.schema.json#/$defs/selector"
      },
      "maxItems": 128
    },
    "observedState": {
      "enum": [
        "idle",
        "allocated",
        "draining",
        "fenced"
      ]
    },
    "allocationId": {
      "$ref": "common.schema.json#/$defs/opaqueId"
    },
    "capabilities": {
      "anyOf": [
        {
          "$ref": "#/$defs/RuntimeCompletionCapabilities"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "initialLabels": {
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "title": "Initiallabels",
      "type": "array"
    },
    "supportedRuntimeAdapters": {
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "title": "Supportedruntimeadapters",
      "type": "array"
    },
    "workspaceCapabilities": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorkspaceCapabilities"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "supportedPerformanceMetricsVersions": {
      "$ref": "performance.schema.json#/$defs/supportedPerformanceMetricsVersions"
    }
  },
  "required": [
    "apiVersion",
    "instanceId",
    "softwareVersion",
    "startedAt",
    "controlUrl",
    "a2aUrl",
    "supportedRuntimes",
    "supportedToolsets",
    "supportedSandboxProfiles",
    "observedState",
    "initialLabels",
    "supportedRuntimeAdapters"
  ],
  "title": "AgentRegistration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractor.local/schema/v1alpha1/agent-registration.schema.json",
  "allOf": [
    {
      "if": {
        "properties": {
          "observedState": {
            "enum": [
              "allocated",
              "draining"
            ]
          }
        }
      },
      "then": {
        "required": [
          "allocationId"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "observedState": {
            "const": "idle"
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "allocationId"
          ]
        }
      }
    }
  ]
}
