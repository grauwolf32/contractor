{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractor.local/schema/v1alpha1/agent-registration.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "instanceId", "startedAt", "controlUrl", "a2aUrl", "supportedRuntimes", "supportedToolsets", "supportedSandboxProfiles", "observedState"],
  "properties": {
    "apiVersion": {"$ref": "common.schema.json#/$defs/apiVersion"},
    "instanceId": {"$ref": "common.schema.json#/$defs/opaqueId"},
    "startedAt": {"$ref": "common.schema.json#/$defs/timestamp"},
    "controlUrl": {"type": "string", "format": "uri", "pattern": "^https?://"},
    "a2aUrl": {"type": "string", "format": "uri", "pattern": "^https?://"},
    "supportedRuntimes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/selector"}},
    "supportedToolsets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref", "tools"],
        "properties": {
          "ref": {"$ref": "common.schema.json#/$defs/selector"},
          "tools": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "supportedSandboxProfiles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/selector"}},
    "observedState": {"enum": ["idle", "allocated", "draining", "fenced"]},
    "allocationId": {"$ref": "common.schema.json#/$defs/opaqueId"}
  },
  "allOf": [
    {
      "if": {"properties": {"observedState": {"const": "idle"}}},
      "then": {"not": {"required": ["allocationId"]}},
      "else": {"required": ["allocationId"]}
    }
  ]
}
