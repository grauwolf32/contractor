{
  "$defs": {
    "Identity": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "anonymous",
            "basic",
            "bearer",
            "cookies"
          ]
        },
        "origins": {
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "x-maxBytes": 8192
          },
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "x-maxBytes": 256
        },
        "tenant": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "x-maxBytes": 256
        },
        "credential": {
          "$ref": "#/$defs/RuntimeCredentialRef"
        }
      },
      "required": [
        "id",
        "kind",
        "origins"
      ],
      "type": "object"
    },
    "Route": {
      "additionalProperties": false,
      "properties": {
        "origin": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "x-maxBytes": 8192
        },
        "pathPrefixes": {
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "x-maxBytes": 8192
          },
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true
        },
        "methods": {
          "items": {
            "type": "string",
            "enum": [
              "GET",
              "HEAD",
              "POST",
              "PUT",
              "PATCH",
              "DELETE",
              "OPTIONS",
              "TRACE",
              "CONNECT"
            ]
          },
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "uniqueItems": true
        },
        "addressRanges": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true
        }
      },
      "required": [
        "origin",
        "pathPrefixes",
        "methods",
        "addressRanges"
      ],
      "type": "object"
    },
    "RuntimeCredentialRef": {
      "additionalProperties": false,
      "properties": {
        "credentialId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9_-]*$",
          "type": "string"
        },
        "kind": {
          "enum": [
            "caido-bearer@1",
            "interactsh-token@1",
            "http-origin-basic@1",
            "http-origin-bearer@1",
            "http-proxy-basic@1",
            "http-proxy-bearer@1",
            "otlp-headers@1",
            "target-basic@1",
            "target-bearer@1",
            "target-cookies@1"
          ],
          "type": "string"
        }
      },
      "required": [
        "credentialId",
        "kind"
      ],
      "type": "object"
    },
    "HTTPLimits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requestsPerSecond": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "concurrentRequests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "requestBodyBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        },
        "responseBodyBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      }
    },
    "Egress": {
      "additionalProperties": false,
      "properties": {
        "routes": {
          "items": {
            "$ref": "#/$defs/Route"
          },
          "type": "array",
          "minItems": 1,
          "maxItems": 128
        },
        "exclusions": {
          "items": {
            "$ref": "#/$defs/Route"
          },
          "type": "array",
          "minItems": 0,
          "maxItems": 128
        }
      },
      "required": [
        "routes",
        "exclusions"
      ],
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "contractor.engagement.v1",
      "type": "string"
    },
    "identities": {
      "items": {
        "$ref": "#/$defs/Identity"
      },
      "type": "array",
      "minItems": 1,
      "maxItems": 8
    },
    "egress": {
      "$ref": "#/$defs/Egress"
    },
    "limits": {
      "$ref": "#/$defs/HTTPLimits"
    }
  },
  "required": [
    "schema",
    "egress",
    "identities"
  ],
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractor.local/schema/v1alpha1/engagement.schema.json",
  "description": "Closed non-secret network policy. Shared validators additionally enforce canonical URL/path/CIDR grammar and identity origins against allowed egress route origins."
}
