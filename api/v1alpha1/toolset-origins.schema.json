{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "toolsets": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*@[A-Za-z0-9][A-Za-z0-9._+-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "layer",
          "configs"
        ],
        "properties": {
          "layer": {
            "enum": [
              "default",
              "run_labels"
            ]
          },
          "configs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "$ref": "allocation.schema.json#/$defs/RuntimeConfigRef"
            }
          }
        }
      }
    }
  },
  "$id": "https://contractor.local/schema/v1alpha1/toolset-origins.schema.json"
}
