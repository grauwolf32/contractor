{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractor.local/schema/v1alpha1/artifact-metadata.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "artifact",
    "mediaType",
    "size",
    "contentCacheKey"
  ],
  "properties": {
    "apiVersion": {
      "$ref": "common.schema.json#/$defs/apiVersion"
    },
    "artifact": {
      "$ref": "common.schema.json#/$defs/exactArtifactRef"
    },
    "mediaType": {
      "$ref": "common.schema.json#/$defs/mediaType"
    },
    "size": {
      "type": "integer",
      "minimum": 0,
      "maximum": 67108864
    },
    "contentCacheKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$",
      "not": {
        "pattern": "[^A-Za-z0-9_-]"
      }
    }
  }
}
