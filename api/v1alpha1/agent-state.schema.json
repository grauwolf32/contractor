{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractor.local/schema/v1alpha1/agent-state.schema.json",
  "$defs": {
    "uint64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "positiveUint64": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "executionError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string", "minLength": 1, "maxLength": 4096},
        "retryable": {"type": "boolean"}
      }
    },
    "workerBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxModelCalls",
        "maxToolCalls",
        "maxTotalTokens",
        "observedModelCalls",
        "observedToolCalls",
        "observedTotalTokens",
        "tokenUsageUnavailable"
      ],
      "properties": {
        "maxModelCalls": {"type": "integer", "minimum": 1, "maximum": 1000},
        "maxToolCalls": {"type": "integer", "minimum": 1, "maximum": 10000},
        "maxTotalTokens": {"type": "integer", "minimum": 1, "maximum": 100000000},
        "observedModelCalls": {"$ref": "#/$defs/uint64"},
        "observedToolCalls": {"$ref": "#/$defs/uint64"},
        "observedTotalTokens": {"$ref": "#/$defs/uint64"},
        "tokenUsageUnavailable": {"$ref": "#/$defs/uint64"},
        "exhausted": {"enum": ["model_calls", "tool_calls", "total_tokens"]}
      }
    },
    "toolCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["callId", "tool", "argumentsTruncated", "outcome"],
      "properties": {
        "callId": {"type": "string", "minLength": 1},
        "tool": {"type": "string", "minLength": 1},
        "arguments": {"type": "object"},
        "argumentsTruncated": {"type": "boolean"},
        "outcome": {"enum": ["succeeded", "failed"]},
        "durationMs": {"$ref": "#/$defs/uint64"},
        "resultSizeBytes": {"$ref": "#/$defs/uint64"},
        "error": {"$ref": "#/$defs/executionError"}
      },
      "allOf": [
        {
          "if": {"properties": {"outcome": {"const": "failed"}}},
          "then": {"required": ["error"]},
          "else": {"not": {"required": ["error"]}}
        }
      ]
    },
    "allocationMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["counters", "toolCalls", "errors", "finalOutcome", "truncated"],
      "properties": {
        "counters": {
          "type": "object",
          "maxProperties": 10000,
          "propertyNames": {
            "maxLength": 128,
            "pattern": "^[a-z0-9_]+(?:\\.[a-z0-9_]+)*$"
          },
          "additionalProperties": {"$ref": "#/$defs/uint64"}
        },
        "toolCalls": {
          "type": "array",
          "maxItems": 1000,
          "items": {"$ref": "#/$defs/toolCall"}
        },
        "errors": {
          "type": "array",
          "maxItems": 100,
          "items": {"$ref": "#/$defs/executionError"}
        },
        "finalOutcome": {
          "type": ["string", "null"],
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "truncated": {"type": "boolean"},
        "workerBudget": {"$ref": "#/$defs/workerBudget"}
      }
    },
    "invocationToolMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calls", "failures"],
      "properties": {
        "calls": {"$ref": "#/$defs/uint64"},
        "failures": {"$ref": "#/$defs/uint64"}
      }
    },
    "invocationMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelCalls",
        "modelErrors",
        "inputTokens",
        "outputTokens",
        "totalTokens",
        "cachedInputTokens",
        "tokenUsageUnavailable",
        "latestPromptTokens",
        "toolCalls",
        "toolErrors",
        "tools",
        "truncated"
      ],
      "properties": {
        "modelCalls": {"$ref": "#/$defs/uint64"},
        "modelErrors": {"$ref": "#/$defs/uint64"},
        "inputTokens": {"$ref": "#/$defs/uint64"},
        "outputTokens": {"$ref": "#/$defs/uint64"},
        "totalTokens": {"$ref": "#/$defs/uint64"},
        "cachedInputTokens": {"$ref": "#/$defs/uint64"},
        "tokenUsageUnavailable": {"$ref": "#/$defs/uint64"},
        "latestPromptTokens": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/uint64"}
          ]
        },
        "toolCalls": {"$ref": "#/$defs/uint64"},
        "toolErrors": {"$ref": "#/$defs/uint64"},
        "tools": {
          "type": "object",
          "maxProperties": 256,
          "propertyNames": {"maxLength": 64, "pattern": "^[a-z][a-z0-9_-]*$"},
          "additionalProperties": {"$ref": "#/$defs/invocationToolMetrics"}
        },
        "truncated": {"type": "boolean"}
      }
    },
    "summarizerState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "modelCalls",
        "inputTokens",
        "outputTokens",
        "totalTokens",
        "tokenUsageUnavailable"
      ],
      "properties": {
        "phase": {"enum": ["disabled", "not_requested", "requested", "succeeded", "failed"]},
        "requestStateRevision": {"$ref": "#/$defs/positiveUint64"},
        "modelCalls": {"type": "integer", "minimum": 0, "maximum": 1},
        "inputTokens": {"$ref": "#/$defs/uint64"},
        "outputTokens": {"$ref": "#/$defs/uint64"},
        "totalTokens": {"$ref": "#/$defs/uint64"},
        "tokenUsageUnavailable": {"type": "integer", "minimum": 0, "maximum": 1},
        "failureCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        }
      },
      "allOf": [
        {
          "if": {"properties": {"phase": {"enum": ["requested", "succeeded", "failed"]}}},
          "then": {"required": ["requestStateRevision"]},
          "else": {"not": {"required": ["requestStateRevision"]}}
        },
        {
          "if": {"properties": {"phase": {"const": "failed"}}},
          "then": {"required": ["failureCode"]},
          "else": {"not": {"required": ["failureCode"]}}
        }
      ]
    },
    "workspacePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*://).+$"
    },
    "workspaceInteraction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "firstOrdinal",
        "lastOrdinal",
        "discoveryCalls",
        "readCalls",
        "matchCalls",
        "mutationCalls"
      ],
      "properties": {
        "path": {"$ref": "#/$defs/workspacePath"},
        "firstOrdinal": {"$ref": "#/$defs/positiveUint64"},
        "lastOrdinal": {"$ref": "#/$defs/positiveUint64"},
        "discoveryCalls": {"$ref": "#/$defs/uint64"},
        "readCalls": {"$ref": "#/$defs/uint64"},
        "matchCalls": {"$ref": "#/$defs/uint64"},
        "mutationCalls": {"$ref": "#/$defs/uint64"}
      }
    },
    "workspaceObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspaceDigest",
        "scopePaths",
        "scopeComplete",
        "interactions",
        "detailComplete"
      ],
      "properties": {
        "workspaceDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "scopePaths": {
          "type": "array",
          "maxItems": 10000,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/workspacePath"}
        },
        "scopeComplete": {"type": "boolean"},
        "interactions": {
          "type": "array",
          "maxItems": 10000,
          "items": {"$ref": "#/$defs/workspaceInteraction"}
        },
        "detailComplete": {"type": "boolean"}
      }
    },
    "invocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invocationId", "subtaskId", "phase", "metrics", "summarizer", "workspace"],
      "properties": {
        "invocationId": {"type": "string", "minLength": 1, "maxLength": 128},
        "subtaskId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "phase": {"enum": ["running", "succeeded", "failed", "cancelled"]},
        "metrics": {"$ref": "#/$defs/invocationMetrics"},
        "summarizer": {"$ref": "#/$defs/summarizerState"},
        "workspace": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/workspaceObservation"}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"phase": {"not": {"const": "running"}}}},
          "then": {
            "properties": {
              "summarizer": {
                "properties": {"phase": {"not": {"const": "requested"}}}
              }
            }
          }
        }
      ]
    },
    "runningInvocation": {
      "allOf": [
        {"$ref": "#/$defs/invocation"},
        {"properties": {"phase": {"const": "running"}}}
      ]
    },
    "completedInvocation": {
      "allOf": [
        {"$ref": "#/$defs/invocation"},
        {"properties": {"phase": {"enum": ["succeeded", "failed", "cancelled"]}}}
      ]
    },
    "contractorWorkerState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "stateRevision",
        "metrics",
        "currentInvocation",
        "lastCompletedInvocation"
      ],
      "properties": {
        "schemaVersion": {"const": 2},
        "stateRevision": {"$ref": "#/$defs/positiveUint64"},
        "metrics": {"$ref": "#/$defs/allocationMetrics"},
        "currentInvocation": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/runningInvocation"}
          ]
        },
        "lastCompletedInvocation": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/completedInvocation"}
          ]
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "state"],
  "properties": {
    "apiVersion": {"$ref": "common.schema.json#/$defs/apiVersion"},
    "state": {"$ref": "#/$defs/contractorWorkerState"}
  }
}
