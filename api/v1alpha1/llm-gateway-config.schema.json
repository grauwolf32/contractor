{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractor.local/schema/v1alpha1/llm-gateway-config.schema.json",
  "$defs": {
    "failureSignature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "oneOf": [{"required": ["messageEquals"]}, {"required": ["litellmWrapped"]}],
      "properties": {
        "status": {"type": "integer", "enum": [400, 404, 409, 422]},
        "messageEquals": {"type": "string", "minLength": 1, "maxLength": 512},
        "litellmWrapped": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    },
    "failureSignatures": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "modelUnavailable": {
          "type": "array",
          "maxItems": 32,
          "items": {"$ref": "#/$defs/failureSignature"}
        },
        "permanentCodes": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}
        }
      }
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gatewayId", "version", "digest"],
      "properties": {
        "gatewayId": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
        "version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "credentialManager": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "managementUrl"],
      "properties": {
        "implementation": {"const": "litellm-virtual-keys@1"},
        "managementUrl": {
          "type": "string",
          "oneOf": [
            {"pattern": "^https://[^/?#@]+$"},
            {"pattern": "^http://(?:127(?:\\.[0-9]{1,3}){3}|\\[::1\\])(?::[0-9]+)?$"}
          ]
        }
      }
    },
    "resolved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "protocol", "url"],
      "properties": {
        "ref": {"$ref": "#/$defs/ref"},
        "protocol": {"const": "openai-compatible@1"},
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://[^/?#@]+/[^?#]*$"
        },
        "credentialManager": {"$ref": "#/$defs/credentialManager"},
        "failureSignatures": {"$ref": "#/$defs/failureSignatures"}
      }
    }
  },
  "$ref": "#/$defs/resolved"
}

