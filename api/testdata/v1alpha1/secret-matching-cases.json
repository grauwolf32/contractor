{
  "description": "Secret matching in telemetry text (docs/spec/platform/observability.md#OBS-R31, docs/spec/platform/limits.md#LIM-OBS-3). A secret equal to the whole text matches; a secret of at least minSubstringBytes UTF-8 bytes matches anywhere; long secrets are replaced longest first, then in byte order. redacted is the text with marker in place of each match; contains is whether any secret matches. Read by internal/helpers/secretmatch and contractor_runtime.redaction.",
  "minSubstringBytes": 16,
  "marker": "[REDACTED]",
  "cases": [
    {
      "name": "short secret as the complete text",
      "secrets": [
        "admin"
      ],
      "text": "admin",
      "redacted": "[REDACTED]",
      "contains": true
    },
    {
      "name": "short secret inside a word stays",
      "secrets": [
        "admin"
      ],
      "text": "administrator login failed",
      "redacted": "administrator login failed",
      "contains": false
    },
    {
      "name": "one-letter secret never garbles text",
      "secrets": [
        "a"
      ],
      "text": "cannot read main.go",
      "redacted": "cannot read main.go",
      "contains": false
    },
    {
      "name": "short secret inside an identifier stays",
      "secrets": [
        "a"
      ],
      "text": "tool_call_failed",
      "redacted": "tool_call_failed",
      "contains": false
    },
    {
      "name": "long secret anywhere",
      "secrets": [
        "tok-0123456789abc"
      ],
      "text": "Bearer tok-0123456789abc rejected",
      "redacted": "Bearer [REDACTED] rejected",
      "contains": true
    },
    {
      "name": "long secret as the complete text",
      "secrets": [
        "tok-0123456789abc"
      ],
      "text": "tok-0123456789abc",
      "redacted": "[REDACTED]",
      "contains": true
    },
    {
      "name": "password that starts with the username leaves no suffix",
      "secrets": [
        "admin",
        "admin-0123456789-password-xyz"
      ],
      "text": "login admin with admin-0123456789-password-xyz",
      "redacted": "login admin with [REDACTED]",
      "contains": true
    },
    {
      "name": "short prefix listed before a long secret",
      "secrets": [
        "abc",
        "abcdefghijklmnopqrstuvwxyz0123"
      ],
      "text": "token=abcdefghijklmnopqrstuvwxyz0123",
      "redacted": "token=[REDACTED]",
      "contains": true
    },
    {
      "name": "nested long secrets, longest first",
      "secrets": [
        "0123456789abcdef",
        "xx-0123456789abcdef-yy"
      ],
      "text": "a xx-0123456789abcdef-yy b 0123456789abcdef",
      "redacted": "a [REDACTED] b [REDACTED]",
      "contains": true
    },
    {
      "name": "overlapping long secrets of equal length in byte order",
      "secrets": [
        "BCCCCCCCCCCCCCCCC",
        "AAAAAAAAAAAAAAAAB"
      ],
      "text": "AAAAAAAAAAAAAAAABCCCCCCCCCCCCCCCC",
      "redacted": "[REDACTED]CCCCCCCCCCCCCCCC",
      "contains": true
    },
    {
      "name": "15-byte secret is short",
      "secrets": [
        "012345678901234"
      ],
      "text": "id 012345678901234 end",
      "redacted": "id 012345678901234 end",
      "contains": false
    },
    {
      "name": "16-byte secret is long",
      "secrets": [
        "0123456789012345"
      ],
      "text": "id 0123456789012345 end",
      "redacted": "id [REDACTED] end",
      "contains": true
    },
    {
      "name": "multibyte secret long by UTF-8 bytes",
      "secrets": [
        "ключ-секрет"
      ],
      "text": "x ключ-секрет y",
      "redacted": "x [REDACTED] y",
      "contains": true
    },
    {
      "name": "multibyte secret short by UTF-8 bytes",
      "secrets": [
        "пароль"
      ],
      "text": "пароль1",
      "redacted": "пароль1",
      "contains": false
    },
    {
      "name": "multibyte short secret as the complete text",
      "secrets": [
        "пароль"
      ],
      "text": "пароль",
      "redacted": "[REDACTED]",
      "contains": true
    },
    {
      "name": "repeated long secret",
      "secrets": [
        "0123456789abcdef",
        "0123456789abcdef"
      ],
      "text": "0123456789abcdef0123456789abcdef",
      "redacted": "[REDACTED][REDACTED]",
      "contains": true
    },
    {
      "name": "empty secret matches nothing",
      "secrets": [
        ""
      ],
      "text": "anything",
      "redacted": "anything",
      "contains": false
    },
    {
      "name": "empty text",
      "secrets": [
        "admin",
        ""
      ],
      "text": "",
      "redacted": "",
      "contains": false
    }
  ]
}
