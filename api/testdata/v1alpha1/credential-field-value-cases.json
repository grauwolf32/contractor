{
  "description": "The grammar of a credential token or header value that every sender transmits unchanged as one HTTP/1.1 field value (RCF-R113, RCF-R114): visible ASCII characters (0x21-0x7E) with runs of space or tab only between them. It is the intersection of what the Runtime's httpx and h11 send (HTP-R33) and what the Server's net/http sends without rejecting or trimming it. Go contracts.ValidCredentialFieldValue, the Python Runtime's contracts.fields.is_credential_field_value, the private allocation.schema.json#/$defs/CredentialFieldValue and the public OpenAPI material schemas give each case its verdict. The corpus is every ASCII character placed by each template of positions ({c} is the character), with the verdict listed per character range, plus values. For each field with maxBytes a reader also builds three bound cases: maxBytes visible characters (valid), maxBytes + 1 (invalid), and maxBytes bytes of an a, spaces and a b (valid). A field is checked where it is listed: credential (the Server's Runtime credential constructor of kind, stored material decoding and the public create request, whose material holds the value at the JSON pointer member), llmCredential (the Server's LLM credential token and its development token) and runtimeSettings (RuntimeSettings decoding in Go and Python and the private schema: base with each pointer in set applied, then the value at pointer). A field without maxBytes takes no bound cases there. The Runtime test also checks that h11 sends every valid value.",
  "base": "valid/runtime-settings-combined.json",
  "positions": {"alone": "{c}", "inside": "a{c}b", "leading": "{c}a", "trailing": "a{c}"},
  "characters": [
    {"from": 0, "to": 8, "valid": []},
    {"from": 9, "to": 9, "valid": ["inside"]},
    {"from": 10, "to": 31, "valid": []},
    {"from": 32, "to": 32, "valid": ["inside"]},
    {"from": 33, "to": 126, "valid": ["alone", "inside", "leading", "trailing"]},
    {"from": 127, "to": 127, "valid": []}
  ],
  "values": [
    {"name": "token", "value": "tok", "valid": true},
    {"name": "scheme-like internal space", "value": "Bearer abc", "valid": true},
    {"name": "internal space run", "value": "a   b", "valid": true},
    {"name": "internal tab run", "value": "a\t\tb", "valid": true},
    {"name": "internal space and tab run", "value": "a \t b", "valid": true},
    {"name": "every visible character", "value": "!\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~", "valid": true},
    {"name": "empty", "value": "", "valid": false},
    {"name": "space only", "value": " ", "valid": false},
    {"name": "tab only", "value": "\t", "valid": false},
    {"name": "trailing space", "value": "tok ", "valid": false},
    {"name": "leading space", "value": " tok", "valid": false},
    {"name": "trailing tab", "value": "tok\t", "valid": false},
    {"name": "leading tab", "value": "\ttok", "valid": false},
    {"name": "trailing VT", "value": "tok\u000b", "valid": false},
    {"name": "trailing FF", "value": "tok\f", "valid": false},
    {"name": "trailing CR", "value": "tok\r", "valid": false},
    {"name": "trailing LF", "value": "tok\n", "valid": false},
    {"name": "inner CRLF", "value": "to\r\nk", "valid": false},
    {"name": "obsolete line folding", "value": "to\r\n k", "valid": false},
    {"name": "NUL", "value": "to\u0000k", "valid": false},
    {"name": "SOH", "value": "to\u0001k", "valid": false},
    {"name": "DEL", "value": "to\u007fk", "valid": false},
    {"name": "Latin-1 letter", "value": "tok\u00e9", "valid": false},
    {"name": "non-ASCII alone", "value": "\u00e9", "valid": false},
    {"name": "no-break space inside", "value": "a\u00a0b", "valid": false},
    {"name": "line separator inside", "value": "a\u2028b", "valid": false},
    {"name": "emoji", "value": "tok\ud83d\uded1", "valid": false}
  ],
  "fields": [
    {"name": "http-origin-bearer@1 token", "maxBytes": 8192, "rule": "LIM-RCF-24", "credential": {"kind": "http-origin-bearer@1", "member": "/token"}, "runtimeSettings": {"pointer": "/httpOriginTarget/bearerToken", "set": {"/httpOriginTarget": {"url": "https://target.example"}}}},
    {"name": "http-proxy-bearer@1 token", "maxBytes": 8192, "rule": "LIM-RCF-24", "credential": {"kind": "http-proxy-bearer@1", "member": "/token"}, "runtimeSettings": {"pointer": "/httpProxy/bearerToken"}},
    {"name": "caido-bearer@1 token", "maxBytes": 8192, "rule": "LIM-RCF-24", "credential": {"kind": "caido-bearer@1", "member": "/token"}, "runtimeSettings": {"pointer": "/caido/bearerToken"}},
    {"name": "interactsh-token@1 token", "maxBytes": 8192, "rule": "LIM-RCF-24", "credential": {"kind": "interactsh-token@1", "member": "/token"}, "runtimeSettings": {"pointer": "/interactsh/token"}},
    {"name": "otlp-headers@1 value", "maxBytes": 4096, "rule": "LIM-RCF-21", "credential": {"kind": "otlp-headers@1", "member": "/headers/authorization"}, "runtimeSettings": {"pointer": "/telemetry/headers/Authorization"}},
    {"name": "LLM credential token", "maxBytes": 16384, "rule": "LIM-RCF-3", "llmCredential": true},
    {"name": "Gateway token in RuntimeSettings", "runtimeSettings": {"pointer": "/llmGatewayToken"}}
  ]
}
