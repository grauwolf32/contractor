{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractor.dev/schemas/scan/v1/scan-plan.schema.json",
  "title": "Contractor ScanPlan v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "source",
    "policy",
    "preparationGaps",
    "candidates",
    "jobs"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^plan-[0-9a-f]{64}$"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "policy": {
      "$ref": "#/$defs/policy"
    },
    "preparationCoverage": {
      "$ref": "#/$defs/coverage"
    },
    "preparationGaps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gap"
      },
      "minItems": 0,
      "maxItems": 4096
    },
    "candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      },
      "minItems": 0,
      "maxItems": 4000
    },
    "jobs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/job"
      },
      "minItems": 0,
      "maxItems": 100
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "name",
        "revision"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "mediaType",
        "contentDigest"
      ],
      "properties": {
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "mediaType": {
          "enum": [
            "application/vnd.contractor.http-requests+json",
            "text/vnd.contractor.target-list"
          ]
        },
        "contentDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputArtifact",
        "maxInputs",
        "maxJobs",
        "maxTotalSeconds",
        "tools"
      ],
      "properties": {
        "inputArtifact": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "maxInputs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "maxJobs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "maxTotalSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/toolPolicy"
          },
          "minItems": 1,
          "maxItems": 4
        }
      }
    },
    "toolPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worker",
        "maxJobs",
        "maxTotalSeconds"
      ],
      "properties": {
        "worker": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "maxJobs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "maxTotalSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400
        },
        "testParameters": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.\\[\\]-]*$"
          },
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true
        },
        "wordlistArtifact": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        }
      }
    },
    "tool": {
      "enum": [
        "scan_nuclei",
        "scan_naabu",
        "scan_sqlmap",
        "scan_ffuf"
      ]
    },
    "argumentBinding": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "value"
          ],
          "properties": {
            "source": {
              "const": "literal"
            },
            "value": {
              "oneOf": [
                {
                  "type": "string",
                  "maxLength": 8192
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "number",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "name"
          ],
          "properties": {
            "source": {
              "enum": [
                "parameter",
                "artifact"
              ]
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          }
        }
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "arguments",
        "resultArtifact",
        "timeoutSeconds"
      ],
      "properties": {
        "tool": {
          "$ref": "#/$defs/tool"
        },
        "arguments": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/argumentBinding"
          }
        },
        "resultArtifact": {
          "const": "report"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "worker",
        "tool",
        "sourceIds",
        "selection",
        "code"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^candidate-[0-9a-f]{64}$"
        },
        "worker": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "tool": {
          "$ref": "#/$defs/tool"
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(request-[0-9a-f]{64}|line-[0-9]{4,})$"
          },
          "minItems": 1,
          "maxItems": 1000,
          "uniqueItems": true
        },
        "selection": {
          "enum": [
            "selected",
            "skipped",
            "unavailable"
          ]
        },
        "code": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^([a-z][a-z0-9_]*)?$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "selection": {
                "const": "selected"
              }
            }
          },
          "then": {
            "properties": {
              "code": {
                "const": ""
              }
            }
          },
          "else": {
            "properties": {
              "code": {
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "templateDigest",
        "id",
        "candidateId",
        "worker",
        "tool",
        "namespace",
        "templateRef",
        "execution",
        "timeoutSeconds",
        "parameters",
        "artifacts"
      ],
      "properties": {
        "templateDigest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "id": {
          "type": "string",
          "pattern": "^job-[0-9a-f]{64}$"
        },
        "candidateId": {
          "type": "string",
          "pattern": "^candidate-[0-9a-f]{64}$"
        },
        "worker": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "tool": {
          "$ref": "#/$defs/tool"
        },
        "namespace": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        "templateRef": {
          "type": "string",
          "minLength": 3
        },
        "execution": {
          "$ref": "#/$defs/execution"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "parameters": {
          "type": "object",
          "maxProperties": 1,
          "additionalProperties": {
            "type": "string",
            "maxLength": 8192
          }
        },
        "artifacts": {
          "type": "object",
          "maxProperties": 1,
          "additionalProperties": {
            "$ref": "#/$defs/artifact"
          }
        },
        "request": {
          "$ref": "#/$defs/sqlmapRequest"
        }
      }
    },
    "sqlmapRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "method",
        "url",
        "headers",
        "body",
        "testParameters"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "method": {
          "enum": [
            "GET",
            "HEAD",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "OPTIONS"
          ]
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "^https?://[\\x21-\\x22\\x24-\\x5b\\x5d-\\x7e]+$"
        },
        "headers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/header"
          },
          "minItems": 0,
          "maxItems": 64
        },
        "body": {
          "type": "string",
          "maxLength": 65536
        },
        "testParameters": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.\\[\\]-]*$"
          },
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operations",
        "prepared",
        "skipped",
        "complete"
      ],
      "properties": {
        "operations": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "prepared": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "skipped": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "complete": {
          "type": "boolean"
        }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pointer",
        "code"
      ],
      "properties": {
        "pointer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "^#(?:/(?:[^~]|~[01])*)*$"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      }
    },
    "header": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[!#$%&'*+.^_`|~0-9a-z-]+$"
        },
        "value": {
          "type": "string",
          "maxLength": 8192,
          "pattern": "^[^\\x00-\\x08\\x0a-\\x1f\\x7f]*$"
        }
      }
    }
  }
}
