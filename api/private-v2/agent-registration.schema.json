{
  "$defs": {
    "AgentObservedState": {
      "enum": [
        "idle",
        "allocated",
        "draining",
        "fenced"
      ],
      "title": "AgentObservedState",
      "type": "string"
    },
    "ToolsetCapability": {
      "additionalProperties": false,
      "properties": {
        "ref": {
          "title": "Ref",
          "type": "string"
        },
        "tools": {
          "items": {
            "type": "string"
          },
          "title": "Tools",
          "type": "array"
        }
      },
      "required": [
        "ref",
        "tools"
      ],
      "title": "ToolsetCapability",
      "type": "object"
    },
    "WorkspaceCapabilitiesV2": {
      "additionalProperties": false,
      "properties": {
        "storage": {
          "enum": [
            "local",
            "memory"
          ],
          "title": "Storage",
          "type": "string"
        },
        "modes": {
          "items": {
            "enum": [
              "direct",
              "overlay"
            ],
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 1,
          "title": "Modes",
          "type": "array"
        },
        "limits": {
          "$ref": "#/$defs/WorkspaceLimitsV2"
        }
      },
      "required": [
        "storage",
        "modes",
        "limits"
      ],
      "title": "WorkspaceCapabilitiesV2",
      "type": "object"
    },
    "WorkspaceLimitsV2": {
      "additionalProperties": false,
      "properties": {
        "maxFiles": {
          "exclusiveMinimum": 0,
          "title": "Maxfiles",
          "type": "integer"
        },
        "maxExpandedBytes": {
          "exclusiveMinimum": 0,
          "title": "Maxexpandedbytes",
          "type": "integer"
        },
        "maxManagedTextBytes": {
          "exclusiveMinimum": 0,
          "title": "Maxmanagedtextbytes",
          "type": "integer"
        },
        "maxFileBytes": {
          "exclusiveMinimum": 0,
          "title": "Maxfilebytes",
          "type": "integer"
        }
      },
      "required": [
        "maxFiles",
        "maxExpandedBytes",
        "maxManagedTextBytes",
        "maxFileBytes"
      ],
      "title": "WorkspaceLimitsV2",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "contractor/v1alpha1",
      "title": "Apiversion",
      "type": "string"
    },
    "instanceId": {
      "title": "Instanceid",
      "type": "string"
    },
    "softwareVersion": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$",
      "title": "Softwareversion",
      "type": "string"
    },
    "startedAt": {
      "format": "date-time",
      "title": "Startedat",
      "type": "string"
    },
    "controlUrl": {
      "title": "Controlurl",
      "type": "string"
    },
    "a2aUrl": {
      "title": "A2Aurl",
      "type": "string"
    },
    "supportedRuntimes": {
      "items": {
        "type": "string"
      },
      "title": "Supportedruntimes",
      "type": "array"
    },
    "supportedToolsets": {
      "items": {
        "$ref": "#/$defs/ToolsetCapability"
      },
      "title": "Supportedtoolsets",
      "type": "array"
    },
    "supportedSandboxProfiles": {
      "items": {
        "type": "string"
      },
      "title": "Supportedsandboxprofiles",
      "type": "array"
    },
    "observedState": {
      "$ref": "#/$defs/AgentObservedState"
    },
    "allocationId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Allocationid"
    },
    "privateProtocolVersion": {
      "const": 2,
      "title": "Privateprotocolversion",
      "type": "integer"
    },
    "initialLabels": {
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "title": "Initiallabels",
      "type": "array"
    },
    "supportedRuntimeAdapters": {
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "title": "Supportedruntimeadapters",
      "type": "array"
    },
    "workspaceCapabilities": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorkspaceCapabilitiesV2"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "supportedPerformanceMetricsVersions": {
      "$ref": "../v1alpha1/performance.schema.json#/$defs/supportedPerformanceMetricsVersions"
    }
  },
  "required": [
    "apiVersion",
    "instanceId",
    "softwareVersion",
    "startedAt",
    "controlUrl",
    "a2aUrl",
    "supportedRuntimes",
    "supportedToolsets",
    "supportedSandboxProfiles",
    "observedState",
    "privateProtocolVersion",
    "initialLabels",
    "supportedRuntimeAdapters"
  ],
  "title": "AgentRegistrationV2",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contractor.local/schema/private-v2/agent-registration.schema.json"
}
