{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:playground:portable:suite/v2",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "playground.suite/v2"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "maxLength": 128
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "urn:playground:portable:common#/$defs/DocumentRef"
      },
      "maxItems": 1000,
      "minItems": 1
    },
    "scoring": {
      "$ref": "urn:playground:portable:common#/$defs/Scoring"
    },
    "provenance": {
      "$ref": "urn:playground:portable:common#/$defs/Provenance"
    },
    "extensions": {
      "$ref": "urn:playground:portable:common#/$defs/Extensions"
    }
  },
  "required": [
    "schema_version",
    "id",
    "cases",
    "scoring",
    "provenance"
  ],
  "additionalProperties": false
}
