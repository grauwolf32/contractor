{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:playground:portable:plan/v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "playground.plan/v1"
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "maxLength": 128
    },
    "created_at": {
      "$ref": "urn:playground:portable:common#/$defs/Timestamp"
    },
    "experiment_ref": {
      "$ref": "urn:playground:portable:common#/$defs/DocumentRef"
    },
    "suites": {
      "type": "array",
      "items": {
        "$ref": "urn:playground:portable:common#/$defs/ResolvedSuite"
      },
      "maxItems": 1000,
      "minItems": 1
    },
    "variants": {
      "type": "array",
      "items": {
        "$ref": "urn:playground:portable:common#/$defs/Variant"
      },
      "maxItems": 16,
      "minItems": 1
    },
    "pins": {
      "$ref": "urn:playground:portable:common#/$defs/Pins"
    },
    "members": {
      "type": "array",
      "items": {
        "$ref": "urn:playground:portable:common#/$defs/Member"
      },
      "maxItems": 10000,
      "minItems": 1
    },
    "execution_order": {
      "type": "array",
      "items": {
        "$ref": "urn:playground:portable:common#/$defs/MemberId"
      },
      "maxItems": 10000,
      "minItems": 0,
      "uniqueItems": true
    },
    "budgets": {
      "$ref": "urn:playground:portable:common#/$defs/Budgets"
    },
    "comparison": {
      "$ref": "urn:playground:portable:common#/$defs/ComparisonSpec"
    },
    "publication": {
      "$ref": "urn:playground:portable:common#/$defs/Publication"
    },
    "extensions": {
      "$ref": "urn:playground:portable:common#/$defs/Extensions"
    }
  },
  "required": [
    "schema_version",
    "experiment_id",
    "created_at",
    "experiment_ref",
    "suites",
    "variants",
    "pins",
    "members",
    "execution_order",
    "budgets",
    "comparison",
    "publication"
  ],
  "additionalProperties": false
}
