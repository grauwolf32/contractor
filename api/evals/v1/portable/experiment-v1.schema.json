{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:playground:portable:experiment/v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "playground.experiment/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "maxLength": 128
    },
    "suites": {
      "type": "array",
      "items": {
        "$ref": "urn:playground:portable:common#/$defs/DocumentRef"
      },
      "maxItems": 1000,
      "minItems": 1
    },
    "variants": {
      "type": "array",
      "items": {
        "$ref": "urn:playground:portable:common#/$defs/Variant"
      },
      "maxItems": 16,
      "minItems": 1
    },
    "repetitions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "order": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "alternating",
            "seeded_shuffle"
          ]
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "seed"
      ],
      "additionalProperties": false
    },
    "budgets": {
      "$ref": "urn:playground:portable:common#/$defs/Budgets"
    },
    "comparison": {
      "$ref": "urn:playground:portable:common#/$defs/ComparisonSpec"
    },
    "publication": {
      "$ref": "urn:playground:portable:common#/$defs/Publication"
    },
    "extensions": {
      "$ref": "urn:playground:portable:common#/$defs/Extensions"
    }
  },
  "required": [
    "schema_version",
    "id",
    "suites",
    "variants",
    "repetitions",
    "order",
    "budgets",
    "comparison",
    "publication"
  ],
  "additionalProperties": false
}
