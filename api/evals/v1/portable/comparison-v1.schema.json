{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:playground:portable:comparison/v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "playground.comparison/v1"
    },
    "experiment_ref": {
      "$ref": "urn:playground:portable:common#/$defs/DocumentRef"
    },
    "plan_ref": {
      "$ref": "urn:playground:portable:common#/$defs/DocumentRef"
    },
    "result_refs": {
      "type": "array",
      "items": {
        "$ref": "urn:playground:portable:common#/$defs/DocumentRef"
      },
      "maxItems": 10000,
      "minItems": 0
    },
    "assessment_refs": {
      "type": "array",
      "items": {
        "$ref": "urn:playground:portable:common#/$defs/DocumentRef"
      },
      "maxItems": 10000,
      "minItems": 0
    },
    "baseline": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "maxLength": 128
    },
    "candidate": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "maxLength": 128
    },
    "counts": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]*$",
        "maxLength": 128
      },
      "additionalProperties": {
        "$ref": "urn:playground:portable:common#/$defs/Counts"
      },
      "maxProperties": 16
    },
    "suite_counts": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]*$",
        "maxLength": 128
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "maxLength": 128
        },
        "additionalProperties": {
          "$ref": "urn:playground:portable:common#/$defs/Counts"
        },
        "maxProperties": 16
      },
      "maxProperties": 1000
    },
    "membership_conflicts": {
      "type": "array",
      "items": {
        "$ref": "urn:playground:portable:common#/$defs/MemberId"
      },
      "maxItems": 10000,
      "minItems": 0
    },
    "quality": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]*$",
        "maxLength": 128
      },
      "additionalProperties": {
        "$ref": "urn:playground:portable:common#/$defs/Quality"
      },
      "maxProperties": 16
    },
    "paired_differences": {
      "type": "array",
      "items": {
        "$ref": "urn:playground:portable:common#/$defs/PairSummary"
      },
      "maxItems": 1024,
      "minItems": 0
    },
    "usage": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]*$",
        "maxLength": 128
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "unit": {
            "enum": [
              "tokens",
              "calls",
              "milliseconds"
            ]
          },
          "covered_members": {
            "type": "integer",
            "minimum": 0
          },
          "expected_members": {
            "type": "integer",
            "minimum": 0
          },
          "total": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "p50": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "p90": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "variant_id": {
            "$ref": "urn:playground:portable:common#/$defs/Id"
          },
          "measure": {
            "enum": [
              "input_tokens",
              "output_tokens",
              "total_tokens",
              "cached_input_tokens",
              "model_calls",
              "tool_calls",
              "tool_failures",
              "wall_ms"
            ]
          }
        },
        "required": [
          "unit",
          "covered_members",
          "expected_members",
          "total",
          "p50",
          "p90",
          "variant_id",
          "measure"
        ],
        "additionalProperties": false
      },
      "maxProperties": 128
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "urn:playground:portable:common#/$defs/Diagnostic"
      },
      "maxItems": 1024,
      "minItems": 0
    },
    "conclusion": {
      "enum": [
        "pass",
        "regressions",
        "inconclusive"
      ]
    },
    "extensions": {
      "$ref": "urn:playground:portable:common#/$defs/Extensions"
    }
  },
  "required": [
    "schema_version",
    "experiment_ref",
    "plan_ref",
    "result_refs",
    "assessment_refs",
    "baseline",
    "candidate",
    "counts",
    "suite_counts",
    "membership_conflicts",
    "quality",
    "paired_differences",
    "usage",
    "diagnostics",
    "conclusion"
  ],
  "additionalProperties": false
}
