{
  "schema": "contractor.engagement.v1",
  "egress": {
    "routes": [
      {
        "origin": "https://shop.example.test",
        "pathPrefixes": [
          "/api"
        ],
        "methods": [
          "GET",
          "HEAD",
          "POST",
          "PUT",
          "PATCH",
          "DELETE",
          "OPTIONS",
          "TRACE",
          "CONNECT"
        ],
        "addressRanges": [
          "203.0.113.0/24"
