    }
    include runtimeAgent.allocationCapabilities -> server with {
      title 'RunScope artifacts'
    }
    global predicate withoutContextOnly

    autoLayout LeftRight 100 70
  }

  view productSurface {
    title 'Surface / Browser and API'
    description 'The browser calls Go APIs directly. Node serves the SPA bundle only. Operations and events have separate views.'

