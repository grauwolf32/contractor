    }

    autoLayout LeftRight 100 70
  }

  view allocationPerformance {
    title 'Operations / Allocation Resource Reports and History'
    description 'V32-004 Runtime sampler implemented; Server request/policy/ingestion/history integration V32-005 is in progress, UI planned. CPU and observed RSS peak cover only the Runtime process during ownership, excluding idle/release, children and Podman. No live Runtime polling or per-allocation time series.'

    include browser with {
      title 'Completed Allocations / Run Attempts (planned)'
    }
    include server.runtimeOperations.controlPlane with {
      title 'Trusted Allocation Identity / Optional Policy'
    }
    include artifactDatabase.allocationPolicy with {
      title 'Pinned Requested / Disabled / Unsupported'
    }
    include runtimeAgent.agentControl.controlEndpoint with {
      title 'Private Allocation Control Endpoint'
    }
    include runtimeAgent.agentControl.slotManager with {
      title 'Allocation Ownership / Teardown'
    }
    include runtimeAgent.workerExecution.resourceSampler with {
      title 'Boundary CPU/RSS + 15 s RSS Accumulator'
    }
    include runtimeAgent.workerExecution.executionCollector with {
      title 'Cached Finalize / Abort Report'
    }
    include server.performanceMonitoring.allocationResources with {
      title 'Resource Validation / Terminal History (planned)'
    }
    include server.runtimeOperations.telemetry with {
      title 'Existing Report Ingestion / Retention'
    }
    include artifactDatabase.executionReports with {
      title 'Existing Reports / 30-day Terminal Retention'
    }
    include server.workspaceLifecycle.runStore with {
      title 'Durable Terminal Allocations / Stages'
    }

    exclude * -> *
    include server.runtimeOperations.controlPlane -> artifactDatabase.allocationPolicy with {
      title 'Persist original decision; never affect placement'
    }
    include server.runtimeOperations.controlPlane -> runtimeAgent.agentControl.controlEndpoint with {
      title 'Existing private control protocol'
    }
    include runtimeAgent.agentControl.controlEndpoint -> runtimeAgent.agentControl.slotManager with {
      title 'Prepare / finalize / abort / release'
    }
    include runtimeAgent.agentControl.slotManager -> runtimeAgent.workerExecution.resourceSampler with {
      title 'Requested only; start before prepare, freeze after teardown'
    }
    include runtimeAgent.workerExecution.resourceSampler -> runtimeAgent.workerExecution.executionCollector with {
      title 'Constant-size runtime.resources; explicit partial/unknown'
    }
    include runtimeAgent.workerExecution.executionCollector -> server.runtimeOperations.controlPlane with {
      title 'Existing cached final report transport'
    }
    include server.runtimeOperations.controlPlane -> server.performanceMonitoring.allocationResources with {
      title 'Validate optional block independently'
    }
    include server.performanceMonitoring.allocationResources -> artifactDatabase.allocationPolicy with {
      title 'History uses pinned policy, not current switch'
    }
    include server.performanceMonitoring.allocationResources -> server.runtimeOperations.telemetry with {
      title 'Invalid resources do not poison valid execution reports'
    }
    include server.runtimeOperations.telemetry -> artifactDatabase.executionReports with {
      title 'Existing immutable/idempotent report storage'
    }
    include server.performanceMonitoring.allocationResources -> server.workspaceLifecycle.runStore with {
      title 'Owner-filtered keyset; missing/late reports stay visible'
    }
    include browser -> server.performanceMonitoring.allocationResources with {
      title 'Bounded history after live registry release'
    }

    autoLayout LeftRight 100 70
  }

  view processBootstrap {
    title 'Operations / Process Settings and Local Go Profiling'
    description 'V36-001 and V32-007 implemented. Optional ServerConfig is non-secret bootstrap, separate from published execution configs and durable Scheduler settings. Defaults < YAML < environment < CLI; restart-only. pprof defaults off independently of performance collection; no browser profiling API.'

    include operator with {
      title 'Deployment / Diagnostic Operator'
    }
    include serverConfigFile with {
      title 'Optional Strict ServerConfig YAML'
    }
    include server.identityConfiguration.processSettings with {
      title 'Immutable Process Settings'
    }
    include server.artifactPlane.blobStore with {
      title 'Installation Blob Selection'
      navigateTo artifactBackends
    }
    include server.performanceMonitoring with {
      title 'Performance Collection Switch'
      navigateTo serverPerformance
    }
    include server.profilingListener with {
      title 'Independent Loopback pprof Listener'
    }
    include server.artifactPlane.gitImporter with {
      title 'Git Import / Remote Allowlist'
      navigateTo gitArtifacts
    }

    exclude * -> *
    include operator -> serverConfigFile with {
      title 'Non-secret paths / switches; no DB URL or key bytes'
    }
    include server.identityConfiguration.processSettings -> serverConfigFile with {
      title 'Strict 64 KiB YAML; relative paths beside file'
    }
    include server.identityConfiguration.processSettings -> server.artifactPlane.blobStore with {
      title 'Validate backend/path before readiness'
    }
    include server.identityConfiguration.processSettings -> server.performanceMonitoring with {
      title 'Metrics default on; opt-out skips new resources'
    }
    include server.identityConfiguration.processSettings -> server.profilingListener with {
      title 'Independent opt-in / finite shutdown'
    }
    include server.identityConfiguration.processSettings -> server.artifactPlane.gitImporter with {
      title 'Allowlisted remotes / read-only SSH trust'
    }
    include operator -> server.profilingListener with {
      title 'Local/SSH tunnel; CPU <= 60 s, trace <= 10 s'
    }

    autoLayout LeftRight 100 70
  }

