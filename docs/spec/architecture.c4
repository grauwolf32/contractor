// Target architecture for docs/spec/00–20 and tasks/index.yml.
// V25–V27 additions include planned work; dashed #planned elements are not yet
// implemented. Task files remain authoritative for delivery status.
specification {
  element actor {
    style {
      shape person
    }
  }

  element system

  element component {
    style {
      shape rectangle
    }
  }

  element storage {
    style {
      shape storage
    }
  }

  tag contractor
  tag adk
  tag external
  tag optional
  tag contextOnly
  tag planned
}

global {
  predicateGroup withoutContextOnly {
    exclude * -> * where tag is #contextOnly
  }

  styleGroup ownership {
    style element.tag = #contractor {
      color primary
    }
    style element.tag = #adk {
      color green
    }
    style element.tag = #external {
      color gray
      border dashed
    }
    style element.tag = #optional {
      opacity 60%
    }
    style element.tag = #planned {
      border dashed
    }
  }
}

model {
  browser = actor 'User Browser' {
    #external
  }

  apiClient = actor 'Non-UI API Client' {
    #external
  }

  webUi = system 'Contractor Web UI — React/TypeScript SPA on a separate Node.js service' {
    #contractor
  }

  llmGateway = system 'LLM Gateway — LiteLLM or compatible backend' {
    #external
  }

  llmProvider = system 'Model Provider' {
    #external
  }

  workerHttpProxy = system 'Worker HTTP Proxy — Caido or compatible instance' {
    #external #optional
  }

  configFilesystem = system 'Published config roots — YAML/text definitions + bundled Skill sources' {
    #external
  }

  credentialMasterKey = system 'Credential Master-Key File — host bootstrap secret' {
    #external
  }

  gatewayAdminBindings = system 'Gateway Admin Bindings + LiteLLM Master-Key Files — host bootstrap secrets' {
    #external
  }

  localAuthBootstrap = system 'Local Auth File — one user + Argon2id password hash' {
    #external
  }

  artifactDatabase = system 'PostgreSQL — Contractor State' {
    #external

    projectState = storage 'Projects / targets / lifecycle / deletion claims / create idempotency' {
      #contractor
    }

    runState = storage 'Workflow snapshots / Runs / StageExecutions / Queue controls / results / events / create idempotency' {
      #contractor
    }

    auditState = storage 'Audits / immutable Rounds + Items / Executions + ExecutionItems / intents / receipts / holds / revisions + events' {
      #contractor
    }

    schedulerSettings = storage 'scheduler_settings — global maxConcurrentRuns 1..32, default 1 / revision / updatedAt' {
      #contractor #planned
    }

    plannerSessions = storage 'Contractor Planner Sessions — completion recovery + typed plans + redacted ADK facts' {
      #contractor
    }

    executionReports = storage 'Execution reports / accepted StageMetrics' {
      #contractor
    }

    credentials = storage 'AES-256-GCM encrypted immutable LLM + RuntimeAdapter credentials' {
      #contractor
    }

    runtimeConfiguration = storage 'Immutable RuntimeConfigs / revisioned label bindings / Agent principals + labels' {
      #contractor
    }

    artifactVersions = storage 'Artifact versions / UserScope, ProjectScope and RunScope bindings / CAS' {
      #contractor
    }

    artifactEvents = storage 'Scoped artifact events / grants / lineage' {
      #contractor
    }
  }

  blobBackend = system 'Artifact Blob Backend — PostgreSQL or S3' {
    #external
  }

  telemetryBackend = system 'Telemetry Backend — optional' {
    #external #optional
  }

  runtimeWorkspaceStorage = system 'Runtime workspace storage — disposable local root or isolated memory' {
    #external #optional
  }

  caidoService = system 'Caido — optional forward proxy and GraphQL control API' {
    #external #optional
  }

  server = system 'Contractor Server' {
    #contractor

    productSurface = component 'Product Surface — authenticated Projects, Audits, Runs, Queue and Artifacts' {
      #contractor

      publicApi = component 'Projects / Runs / Queue API' {
        #contractor
      }

      auditApi = component 'Audit / read-only AuditProfile API — owner commands, exact review decisions and revision polling' {
        #contractor #planned
      }

      userArtifactApi = component 'UserScope / ProjectScope Artifact API' {
        #contractor
      }

      authApi = component 'Local Login / Session / CSRF API' {
        #contractor
      }

      eventApi = component 'Read-only WebSocket Event API' {
        #contractor
      }
    }

    identityConfiguration = component 'Identity and Configuration — immutable execution inputs and secret boundaries' {
      #contractor

      authService = component 'In-memory Local Session + Principal Boundary' {
        #contractor
      }

      executionConfigService = component 'Execution Profiles + Model/Gateway Config + Credential Boundary' {
        #contractor
      }

      runtimeConfigService = component 'Default + Run/Agent Label Resolver / RuntimeAdapter Credential Boundary' {
        #contractor
      }
    }

    orchestration = component 'Workflow Orchestration — immutable snapshots, Stage planning and acceptance' {
      #contractor

      workflowCatalog = component 'Workflow Catalog' {
        #contractor
      }

      agentTemplateCatalog = component 'AgentTemplate Catalog — versioned behavior definitions' {
        #contractor
      }

      skillCatalog = component 'Agent Skill Catalog — validate bundled sources; resolve/fork ordinary owner artifacts' {
        #contractor
      }

      workflowScheduler = component 'Workflow Scheduler' {
        #contractor
      }

      runService = component 'Trusted Run Service — ordinary creation + atomic pinned AuditExecution association' {
        #contractor #planned
      }

      schedulerSupervisor = component 'Scheduler Supervisor — bounded concurrent Run lanes; resize by drain' {
        #contractor #planned
      }

      schedulerMaintenance = component 'Scheduler Maintenance — bounded loss polling, terminal release and cleanup outside Run lanes' {
        #contractor #planned
      }

      plannerFactories = component 'PlannerFactory Registry' {
        #contractor
      }

      stagePlanner = component 'Stage-local Planner — Passthrough, Streamline or Router ADK' {
        #contractor
      }

      plannerSessionService = component 'Database-backed Planner SessionService' {
        #contractor
      }

      workerInvokerTools = component 'Validated Current-Subtask Adapter — direct A2A WorkerInvoker' {
        #contractor
      }

      plannerStateTools = component 'Typed Planner State Projections — no raw keys' {
        #contractor
      }

      plannerArtifactInspector = component 'Planner ArtifactInspector — exact RunScope validation' {
        #contractor
      }

      plannerMemoryTools = component 'Planner MemoryTools — thin bound ArtifactStore wrapper / hidden CAS' {
        #contractor
      }
    }

    // Spec 19 / V25-V26: Audit coordination and bounded compatible check batches
    // are implemented; broader curated programs remain delivery work.
    auditCoordination = component 'Audit Coordination — Project-bound multi-Run program; PostgreSQL reconciliation' {
      #contractor

      profileCatalog = component 'AuditProfile Catalog — exact resolved Workflow closures + Server compatibility' {
        #contractor
      }

      packageInventory = component 'Audit Packages + Deterministic Inventory — checklist / OpenAPI; bounded ordered manifests' {
        #contractor
      }

      auditStore = component 'Audit Store — epoch-fenced claims, revisions, intents, receipts and exact holds' {
        #contractor
      }

      auditService = component 'Audit Service — atomic baseline start, capability gate, pause/cancel/delete fences' {
        #contractor #planned
      }

      auditController = component 'Audit Controller — periodic reconcile, bounded dispatch, collection and round barriers' {
        #contractor #planned
      }

      resultImporter = component 'Audit Result Import + Coverage — exact terminal receipt, per-item disposition and retained evidence' {
        #contractor #planned
      }

      findingIntake = component 'Private Finding Intake — allocation/invocation-bound proposals, evidence pins and replay receipts' {
        #contractor #planned
      }

      reviewService = component 'Audit Review — authenticated exact-subject decisions, finding triage and next-round approval' {
        #contractor #planned
      }

      // V26: curated programs and bounded batchSize > 1 are separate increments.
      standardCatalog = component 'Audit Standard Catalog — exact licensed packages + evidence mappings; Top 10 / ASVS programs' {
        #contractor #planned
      }
    }

    workspaceLifecycle = component 'Workspace Lifecycle — Projects, owner Queue gate and destructive cleanup' {
      #contractor

      projectStore = component 'Project Store — metadata, target, lifecycle and deletion claims' {
        #contractor
      }

      ownerQueueGate = component 'Owner Queue Gate — durable pause and serialized Stage admission' {
        #contractor
      }

      projectDeletionController = component 'Project Deletion Controller — restart-safe cancel, drain and purge' {
        #contractor
      }

      runStore = component 'Run / Stage Store — lifecycle, Queue projection and terminal Run purge' {
        #contractor
      }
    }

    artifactPlane = component 'Artifact Plane — scoped immutable history, controlled forks and lifecycle purge' {
      #contractor

      artifactService = component 'ArtifactStore Service — UserScope / ProjectScope / RunScope' {
        #contractor
      }

      artifactPurger = component 'Controlled Scope Purger — released RunScope / drained ProjectScope only' {
        #contractor
      }

      artifactRegistry = component 'Artifact Registry Adapter' {
        #contractor
      }

      blobStore = component 'ArtifactBlobStore Adapter' {
        #contractor
      }
    }

    runtimeOperations = component 'Runtime Fleet and Operations — placement, private control and telemetry' {
      #contractor

      operationsApi = component 'Operations / Configuration / Scheduler Settings API' {
        #contractor
      }

      schedulerSettingsService = component 'Scheduler Settings Service — global typed singleton; GET / PUT with strong If-Match' {
        #contractor #planned
      }

      controlPlane = component 'Control Plane' {
        #contractor
      }

      runtimeRegistry = component 'Runtime Agent Registry / Slot Allocator' {
        #contractor
      }

      telemetry = component 'Execution Report Collector / optional exporters' {
        #contractor
      }
    }

    productSurface.publicApi -> identityConfiguration.authService 'Authenticate session and bind owner principal'
    productSurface.auditApi -> identityConfiguration.authService 'Authorize owner and ordinary Project; CSRF, idempotency and revision CAS'
    productSurface.userArtifactApi -> identityConfiguration.authService 'Authenticate session and bind owner scope'
    productSurface.authApi -> identityConfiguration.authService 'Verify Argon2id login; issue/revoke session + CSRF'
    productSurface.eventApi -> identityConfiguration.authService 'Authenticate socket/session/origin and authorize subscriptions'
    runtimeOperations.operationsApi -> identityConfiguration.authService 'Authenticate session and bind audit actor'

    productSurface.publicApi -> orchestration.workflowScheduler 'Cancel Runs and notify runnable work'
    productSurface.publicApi -> orchestration.runService 'Create ordinary standalone, Project and Evaluation Runs'
    productSurface.auditApi -> auditCoordination.profileCatalog 'List exact read-only profiles and current Server compatibility'
    productSurface.auditApi -> auditCoordination.auditService 'Create / start / pause new Audit Runs / resume / cancel / delete'
    productSurface.auditApi -> auditCoordination.auditStore 'Poll authoritative Audit/items/coverage/report projections by revision; no Audit WebSocket'
    productSurface.auditApi -> auditCoordination.reviewService 'Submit authenticated exact-subject decisions and explicit evidence imports'
    productSurface.publicApi -> workspaceLifecycle.projectStore 'Create / query / update Projects; begin deletion with If-Match'
    productSurface.publicApi -> workspaceLifecycle.runStore 'Query/filter Runs and delete released terminal Runs'
    productSurface.publicApi -> workspaceLifecycle.ownerQueueGate 'Read or CAS-update the owner pause state'
    productSurface.publicApi -> identityConfiguration.runtimeConfigService 'Pin default + explicit Run-selected Runtime labels'
    productSurface.userArtifactApi -> artifactPlane.artifactService 'Authenticated UserScope and ProjectScope history / upload / download'
    productSurface.eventApi -> workspaceLifecycle.runStore 'Replay ordered committed Run lifecycle events'
    productSurface.eventApi -> orchestration.plannerSessionService 'Stream only committed redacted Planner facts'
    productSurface.eventApi -> runtimeOperations.runtimeRegistry 'Observe process-local Operations revisions; require resync on gaps'
    productSurface.eventApi -> runtimeOperations.schedulerSettingsService 'Observe schedulerSettings invalidation hints; refetch on reconnect/resync'

    runtimeOperations.operationsApi -> runtimeOperations.runtimeRegistry 'Read authoritative/observed slot state'
    runtimeOperations.operationsApi -> identityConfiguration.executionConfigService 'List/publish configs; create/delete managed credentials without raw tokens'
    runtimeOperations.operationsApi -> identityConfiguration.runtimeConfigService 'Publish RuntimeConfigs; bind labels; assign Agent labels; write-only adapter credentials'
    runtimeOperations.operationsApi -> runtimeOperations.schedulerSettingsService 'GET / PUT /v1/operations/settings/scheduler; Operations capability + CSRF + If-Match'
    runtimeOperations.schedulerSettingsService -> orchestration.schedulerSupervisor 'Post-commit wake hint; increase promptly, decrease drains'
    orchestration.schedulerSupervisor -> runtimeOperations.schedulerSettingsService 'Load before admission; periodically reconcile durable desired limit'
    orchestration.schedulerSupervisor -> workspaceLifecycle.runStore 'Distinct renewable Run claims via FOR UPDATE SKIP LOCKED; priority cancellation and defer rotation'
    orchestration.schedulerSupervisor -> orchestration.workflowScheduler 'At most maxConcurrentRuns bounded progression attempts; one claim and at most one active Stage per Run'
    orchestration.schedulerSupervisor -> orchestration.schedulerMaintenance 'Own dedicated bounded maintenance loops outside execution lanes'
    orchestration.schedulerMaintenance -> runtimeOperations.controlPlane 'Poll allocation loss and recover terminal releases independently of pause or lane capacity'
    orchestration.schedulerMaintenance -> runtimeOperations.telemetry 'Clean expired telemetry independently of semantic execution'
    orchestration.runService -> orchestration.workflowScheduler 'Commit ordinary Run creation through existing lifecycle and wake runnable work'
    orchestration.runService -> workspaceLifecycle.runStore 'Atomic Run, immutable labels and idempotency; trusted AuditExecution association when present'
    orchestration.runService -> workspaceLifecycle.projectStore 'Serialize creation with ordinary Project deletion fence'
    orchestration.runService -> identityConfiguration.executionConfigService 'Ordinary resolution or start-pinned Audit Workflow closure; credential lifecycle barriers'
    orchestration.runService -> identityConfiguration.runtimeConfigService 'Ordinary Run resolution or exact start-pinned Audit RuntimeConfig snapshot'
    orchestration.runService -> orchestration.skillCatalog 'Ordinary exact skill resolution or retained start-pinned Audit packages; never re-resolve current Audit skills'
    orchestration.runService -> artifactPlane.artifactService 'Fork exact inputs, manifests and Skills into ordinary RunScope'
    orchestration.runService -> auditCoordination.auditStore 'Commit trusted submission identity and Run association in the same transaction'

    orchestration.workflowScheduler -> orchestration.workflowCatalog 'Resolve Workflow and select ready StageSpec'
    orchestration.workflowCatalog -> identityConfiguration.executionConfigService 'Resolve exact digest-bearing escalation profiles'
    orchestration.workflowScheduler -> orchestration.agentTemplateCatalog 'Resolve and pin exact Stage AgentTemplates'
    orchestration.workflowScheduler -> orchestration.skillCatalog 'Resolve owner refs once; validate and fork exact packages into RunScope'
    orchestration.workflowScheduler -> identityConfiguration.executionConfigService 'Resolve immutable per-Run executionConfig'
    orchestration.workflowScheduler -> workspaceLifecycle.projectStore 'Resolve optional Project snapshot and respect the deleting fence'
    orchestration.workflowScheduler -> workspaceLifecycle.ownerQueueGate 'Serialize every normal Stage admission against durable pause'
    orchestration.workflowScheduler -> workspaceLifecycle.runStore 'CAS Run lifecycle; persist attempts, candidates and terminal outcomes'
    orchestration.workflowScheduler -> runtimeOperations.controlPlane 'Prepare / finalize / abort / release allocations'
    orchestration.workflowScheduler -> orchestration.plannerFactories 'Select declared PlannerFactory'
    orchestration.workflowScheduler -> artifactPlane.artifactService 'Fork exact inputs; freeze Run outputs; publish ordinary Project outputs; audit-managed skips outputs/<slot>'
    orchestration.workflowScheduler -> runtimeOperations.telemetry 'Assemble bounded StageMetrics while finalizing or aborting'
    orchestration.plannerFactories -> orchestration.stagePlanner 'Construct Passthrough/one-Worker Streamline/logical multi-Worker Router'
    orchestration.plannerFactories -> identityConfiguration.executionConfigService 'Resolve pinned Planner credential'
    orchestration.stagePlanner -> orchestration.workerInvokerTools 'Dispatch exact current subtask sequentially; Router selects logical worker_name'
    orchestration.stagePlanner -> orchestration.plannerStateTools 'Query only explicit projections for the newest correlated Worker completion'
    orchestration.plannerStateTools -> runtimeOperations.controlPlane 'Read bounded live Worker State through logical prepared handles'
    orchestration.stagePlanner -> orchestration.plannerArtifactInspector 'Validate exact input, intermediate and candidate refs'
    orchestration.stagePlanner -> orchestration.plannerSessionService 'Durable request/completion, typed plan projection and redacted ADK facts'
    orchestration.stagePlanner -> orchestration.plannerMemoryTools 'Stage-bound Streamline/Router MemoryTools; logical Worker view only'
    orchestration.stagePlanner -> runtimeOperations.telemetry 'Planner ExecutionReport with Run metadata-label trace attributes'
    orchestration.stagePlanner -> identityConfiguration.runtimeConfigService 'Use pinned default/Run-selected Runtime-label Planner telemetry settings'
    orchestration.plannerArtifactInspector -> artifactPlane.artifactService 'Read exact metadata inside current RunScope'
    orchestration.skillCatalog -> artifactPlane.artifactService 'Create missing owner skills/*; resolve current and fork exact revisions into RunScope'
    orchestration.plannerMemoryTools -> artifactPlane.artifactService 'Reserved memory.* canonical note artifacts; hidden Artifact revisions'

    auditCoordination.profileCatalog -> orchestration.workflowCatalog 'Resolve exact Workflow closures after dependency loading; no Audit-specific Scheduler branches'
    auditCoordination.auditService -> workspaceLifecycle.projectStore 'Start/dispatch fence: active ordinary Project only; no standalone or Evaluation Audits'
    auditCoordination.auditService -> auditCoordination.profileCatalog 'Recheck exact profile and input-dependent Server compatibility at start'
    auditCoordination.auditService -> auditCoordination.packageInventory 'Validate exact Project inputs; deterministically freeze complete first worklist'
    auditCoordination.auditService -> identityConfiguration.runtimeConfigService 'Pin one Run RuntimeConfig snapshot; Agent labels remain allocation-time'
    auditCoordination.auditService -> orchestration.skillCatalog 'Pin and retain exact child Workflow Skill revisions/digests at start'
    auditCoordination.auditService -> identityConfiguration.executionConfigService 'Acquire future-dispatch credential holds distinct from evidence retention'
    auditCoordination.auditService -> artifactPlane.artifactService 'Pin exact Project baseline and source Skill packages; no AuditScope'
    auditCoordination.auditService -> auditCoordination.auditStore 'Atomically persist profile/baseline/scope, immutable round/items, holds and lifecycle CAS'
    auditCoordination.auditController -> auditCoordination.auditStore 'Periodic epoch-fenced reconciliation; reserve stable submission intents and cumulative maxSubmittedRuns budget'
    auditCoordination.auditController -> runtimeOperations.schedulerSettingsService 'Transactional per-Audit look-ahead = current maxConcurrentRuns; count intents + nonterminal children; no pinned concurrency policy'
    auditCoordination.auditController -> orchestration.runService 'Replay stable intent with start-pinned Workflow/Runtime/Skill snapshots; internal audit-managed publication'
    auditCoordination.auditController -> workspaceLifecycle.runStore 'Read authoritative child terminal outcome/version; notifications are wake hints only'
    auditCoordination.auditController -> auditCoordination.resultImporter 'Collect every terminal execution before retry/settlement; one receipt even for missing, invalid, failed or cancelled output'
    auditCoordination.auditController -> auditCoordination.packageInventory 'Freeze ordered execution manifest and deterministic bounded task-set package'
    auditCoordination.auditController -> auditCoordination.reviewService 'Apply exact authorized decisions; discovery/assessment/next rounds only after capability and barrier checks'
    auditCoordination.auditController -> orchestration.workflowScheduler 'Request ordinary child cancellation; wait for terminal release while paused or deleting'
    auditCoordination.auditController -> identityConfiguration.executionConfigService 'Release dispatch holds only after dispatch closes and submission intents resolve'
    auditCoordination.resultImporter -> auditCoordination.packageInventory 'Validate frozen manifest digest, complete item membership and versioned evidence contract'
    auditCoordination.resultImporter -> artifactPlane.artifactService 'Retain exact accepted outputs/proposals in protected create-only Audit-managed ProjectScope bindings'
    auditCoordination.resultImporter -> auditCoordination.auditStore 'Commit receipt + each attempt disposition + exact links/holds; truthful coverage gaps, independent of Run success'
    auditCoordination.findingIntake -> runtimeOperations.controlPlane 'Derive allocation/Run provenance, selected Toolset and invocation; never trust audit.* labels'
    auditCoordination.findingIntake -> artifactPlane.artifactService 'Under durable grant/write fence: atomic proposal artifact, exact Run evidence pins and receipt'
    auditCoordination.findingIntake -> auditCoordination.auditStore 'Replay correlated submission digest; optional trusted Audit admission, never automatic confirmation'
    auditCoordination.reviewService -> auditCoordination.auditStore 'CAS/idempotent decisions bind actor + exact subject revision/digest; waiting holds no execution resources'
    auditCoordination.reviewService -> auditCoordination.resultImporter 'Validate and retain explicitly selected human evidence or ordinary-Run proposals'
    auditCoordination.standardCatalog -> artifactPlane.artifactService 'Seed reserved read-only canonical packages; pin exact standard revision/digest and source/license provenance'
    auditCoordination.profileCatalog -> auditCoordination.standardCatalog 'V26 exact Top 10/ASVS identifiers and evidence mappings; no model-authored standard authority'
    auditCoordination.auditService -> auditCoordination.standardCatalog 'V26 retain exact standard package set at start'
    auditCoordination.auditController -> artifactPlane.artifactService 'After cancel/drain/collection: release Audit evidence holds and purge only Audit-managed Project bindings'

    workspaceLifecycle.projectDeletionController -> workspaceLifecycle.projectStore 'Claim and durably advance one monotonic deletion phase'
    workspaceLifecycle.projectDeletionController -> auditCoordination.auditService 'Close Audit dispatch, cancel/drain/collect and release Audit holds before Run/Project purge'
    workspaceLifecycle.projectDeletionController -> orchestration.workflowScheduler 'Request ordinary cancellation and wait for terminal allocation release'
    workspaceLifecycle.projectDeletionController -> workspaceLifecycle.runStore 'Delete every released terminal Project Run idempotently'
    workspaceLifecycle.projectDeletionController -> artifactPlane.artifactPurger 'Purge complete ProjectScope after all Project Runs are gone'
    workspaceLifecycle.runStore -> artifactPlane.artifactPurger 'Purge complete RunScope inside the locked terminal delete'
    workspaceLifecycle.runStore -> auditCoordination.auditStore 'Require terminal release + exact collection receipt for Audit child deletion; retain tombstone provenance and dispose ordinary proposal pins'

    runtimeOperations.controlPlane -> runtimeOperations.runtimeRegistry 'Track live instances / reserve free single slots'
    runtimeOperations.controlPlane -> identityConfiguration.executionConfigService 'Resolve pinned Worker credentials for RuntimeSettings'
    runtimeOperations.controlPlane -> identityConfiguration.runtimeConfigService 'Overlay pinned Run config with candidate Agent labels; resolve adapters + secrets'
    runtimeOperations.controlPlane -> runtimeOperations.telemetry 'Bind allocation final reports and Run metadata labels to trusted execution identity'

    artifactPlane.artifactService -> artifactPlane.artifactRegistry 'Versions / scoped bindings / CAS / grants / events / output publication'
    artifactPlane.artifactService -> artifactPlane.blobStore 'Stream immutable content'
    artifactPlane.artifactPurger -> artifactPlane.artifactRegistry 'Remove complete scope-owned bindings, pins, lineage and unreferenced versions'
    artifactPlane.artifactPurger -> artifactPlane.blobStore 'Collect only globally unreferenced immutable content'
  }

  runtimeAgent = system 'Runtime Agent — N environment-specific single-slot processes' {
    #contractor

    agentControl = component 'Agent Control — registration, capability truth and exclusive allocation ownership' {
      #contractor

      controlEndpoint = component 'Private Control Endpoint' {
        #contractor
      }

      registryClient = component 'Registration / Heartbeat Client' {
        #contractor
      }

      capabilityProbe = component 'Bounded startup probes / immutable capability snapshot' {
        #contractor
      }

      slotManager = component 'Exclusive Slot / Allocation Context' {
        #contractor
      }
    }

    workerExecution = component 'Worker Execution — A2A, ADK, session lifecycle and trusted observations' {
      #contractor

      a2aServer = component 'Allocation-scoped A2A Server' {
        #contractor
      }

      workerRuntime = component 'In-process Worker Runtime — generic adk@1 configured by AgentTemplate' {
        #contractor
      }

      workerSessionLifecycle = component 'Worker Session Lifecycle — Stage-pinned isolated/shared; bounded State carry' {
        #contractor
      }

      workerState = component 'Canonical Contractor State — bounded live invocation and allocation metrics' {
        #contractor
      }

      workerInstrumentation = component 'ADK Worker Instrumentation — typed metrics / observation reducers' {
        #contractor
      }

      resultFinalizer = component 'Result Finalizer — mandatory isolated tool-free structured serialization' {
        #contractor
      }

      terminalSummarizer = component 'Terminal Summarizer — optional isolated tool-free terminal path' {
        #contractor #optional
      }

      executionCollector = component 'Execution / allocation report collector' {
        #contractor
      }
    }

    allocationCapabilities = component 'Allocation Capabilities — narrowed tools, adapters and disposable workspace' {
      #contractor

      adapterHost = component 'Allocation Adapter Host — OTLP / HTTP proxy / Caido clients' {
        #contractor
      }

      sandboxManager = component 'SandboxProfile manager — local-workdir@1 initially, lifecycle isolation only' {
        #contractor
      }

      workspaceProvider = component 'Workspace Provider — exact Run ZIP hydration / local or memory / overlay' {
        #contractor #optional
      }

      filesystemTools = component 'Selected filesystem@1 / edit-files@1 / workspace-changes@1 tools' {
        #contractor #optional
      }

      codeAnalysisTools = component 'Selected code-analysis@1 — shallow Tree-sitter / local graph facade' {
        #contractor #optional
      }

      taintAnnotationTools = component 'Selected taint-annotations@1 — structured atomic workspace mutations' {
        #contractor #optional
      }

      trailmarkChild = component 'Allocation-local Trailmark child — bounded and killable' {
        #contractor #optional
      }

      httpCaidoTools = component 'Selected http-tools@1 / caido@1 tools' {
        #contractor #optional
      }

      securityFindingsTools = component 'Selected security-findings@1 — finding proposals only; no model-selectable Audit/Project identity' {
        #contractor #optional #planned
      }

      namespaceTools = component 'Explicitly selected Namespace-bound domain tools' {
        #contractor
      }

      runArtifactTools = component 'Explicitly selected run-artifacts@1 tools' {
        #contractor
      }

      memoryTools = component 'Explicitly selected memory-tools@1 — allocation-bound logical notes' {
        #contractor
      }

      skillToolset = component 'Native ADK SkillToolset — exact allocation-selected packages / no remote registry' {
        #adk
      }

      artifactClient = component 'Private Artifact API Client / ADK Adapter' {
        #contractor
      }

      modelClient = component 'Model Client — optional' {
        #contractor #optional
      }
    }

    agentControl.controlEndpoint -> agentControl.slotManager 'Reserve / configure / finalize / abort / release the only slot'
    agentControl.capabilityProbe -> agentControl.registryClient 'Publish exact usable runtime / Toolset tools / sandbox / RuntimeAdapter refs once per instance'
    agentControl.slotManager -> allocationCapabilities.adapterHost 'Construct / flush / destroy typed allocation-scoped adapters'
    agentControl.slotManager -> workerExecution.workerRuntime 'Create / destroy one in-process Worker instance'
    agentControl.slotManager -> workerExecution.a2aServer 'Activate / deactivate allocation identity and Agent Card'
    agentControl.slotManager -> workerExecution.workerSessionLifecycle 'Own allocation-local SessionService and carried eligible State'
    agentControl.slotManager -> workerExecution.workerState 'Create / destroy canonical Contractor State'
    agentControl.slotManager -> allocationCapabilities.sandboxManager 'Prepare fresh allocation workdir; clean before idle or remain fenced'
    agentControl.slotManager -> allocationCapabilities.workspaceProvider 'Hydrate exact Run artifacts; create / discard one private WorkspaceSession'
    agentControl.capabilityProbe -> allocationCapabilities.workspaceProvider 'Probe immutable local/memory storage and positive filesystem tool subset'
    agentControl.capabilityProbe -> allocationCapabilities.codeAnalysisTools 'Probe offline Tree-sitter subset and local-only Trailmark subset'
    agentControl.capabilityProbe -> allocationCapabilities.taintAnnotationTools 'Probe complete offline Tree-sitter annotation surface'

    workerExecution.a2aServer -> workerExecution.workerRuntime 'Validate and deliver one sequential A2A Task for the active allocation'
    workerExecution.workerRuntime -> workerExecution.workerSessionLifecycle 'Acquire shared or fresh isolated session only after admission'
    workerExecution.workerSessionLifecycle -> workerExecution.workerState 'Rehydrate Contractor State; snapshot bounded eligible ADK State; carry no isolated events'
    workerExecution.workerRuntime -> workerExecution.resultFinalizer 'Serialize every ordinary terminal text in a separate ephemeral session'
    workerExecution.workerRuntime -> workerExecution.terminalSummarizer 'At a configured boundary, run one independent terminal summary instead'
    workerExecution.workerRuntime -> workerExecution.workerInstrumentation 'Emit ADK run / model / tool callback boundaries'
    workerExecution.workerInstrumentation -> workerExecution.workerState 'Reduce bounded invocation observations and allocation metrics'
    workerExecution.workerInstrumentation -> workerExecution.executionCollector 'Project bounded metrics for the final report'
    agentControl.controlEndpoint -> workerExecution.workerState 'Read immutable Contractor-owned snapshot for Control Plane only'
    agentControl.controlEndpoint -> workerExecution.executionCollector 'Finalize or abort cached reports without semantic work'

    workerExecution.workerRuntime -> allocationCapabilities.namespaceTools 'Construct only AgentTemplate-selected domain tools for fixed Namespace'
    workerExecution.workerRuntime -> allocationCapabilities.runArtifactTools 'Construct selected list/read/write operations; grant remains authoritative'
    workerExecution.workerRuntime -> allocationCapabilities.memoryTools 'Construct selected shared-note operations for fixed Namespace'
    workerExecution.workerRuntime -> allocationCapabilities.filesystemTools 'Construct only selected operations over narrowed Reader / Writer / ChangeSet handles'
    workerExecution.workerRuntime -> allocationCapabilities.codeAnalysisTools 'Construct selected read-only operations over a narrowed Reader snapshot'
    workerExecution.workerRuntime -> allocationCapabilities.taintAnnotationTools 'Construct selected structured mutations over a narrowed Writer'
    workerExecution.workerRuntime -> allocationCapabilities.httpCaidoTools 'Construct only selected bounded HTTP / Caido operations'
    workerExecution.workerRuntime -> allocationCapabilities.securityFindingsTools 'Construct only explicitly selected proposal tool; no Run creation, approval or final assessment'
    workerExecution.workerRuntime -> allocationCapabilities.skillToolset 'Construct from AgentTemplate-selected exact Run package artifacts'
    workerExecution.workerRuntime -> allocationCapabilities.artifactClient 'Prepare-time exact read of reserved skills/* packages; no write or owner/catalog authority'
    workerExecution.workerRuntime -> allocationCapabilities.modelClient 'Semantic Worker model calls when required'
    workerExecution.resultFinalizer -> allocationCapabilities.modelClient 'Exactly one same-budget structured-output call'
    workerExecution.terminalSummarizer -> allocationCapabilities.modelClient 'Exactly one independently budgeted summary call'

    allocationCapabilities.namespaceTools -> allocationCapabilities.artifactClient 'Logical reads / immutable writes / CAS'
    allocationCapabilities.runArtifactTools -> allocationCapabilities.artifactClient 'Read/write/list with explicit CAS preconditions'
    allocationCapabilities.memoryTools -> allocationCapabilities.artifactClient 'Canonical memory.* artifacts with hidden CAS; no model-visible ref/revision'
    allocationCapabilities.adapterHost -> allocationCapabilities.modelClient 'Inject allocation-scoped proxy / telemetry transports'
    allocationCapabilities.adapterHost -> allocationCapabilities.namespaceTools 'Inject proxy-aware clients only into selected tools'
    allocationCapabilities.adapterHost -> allocationCapabilities.httpCaidoTools 'Inject optional forward-proxy and mandatory typed Caido handles'
    allocationCapabilities.filesystemTools -> allocationCapabilities.workspaceProvider 'Relative run_workdir paths only; no raw local path or backend selection'
    allocationCapabilities.codeAnalysisTools -> allocationCapabilities.workspaceProvider 'Read exact effective managed-text snapshots; no provider root'
    allocationCapabilities.codeAnalysisTools -> allocationCapabilities.trailmarkChild 'Materialize bounded private mirror and issue typed graph queries'
    allocationCapabilities.taintAnnotationTools -> allocationCapabilities.workspaceProvider 'Resolve current function syntax and atomically update one managed-text file'
    allocationCapabilities.workspaceProvider -> allocationCapabilities.artifactClient 'Read exact ZIP/state and auto-export cumulative state/diff'
    allocationCapabilities.workspaceProvider -> runtimeWorkspaceStorage 'Create isolated disposable allocation storage'
    allocationCapabilities.httpCaidoTools -> allocationCapabilities.artifactClient 'Persist bounded response bodies as ordinary exact Run artifacts'
    allocationCapabilities.httpCaidoTools -> caidoService 'Target HTTP via optional proxy; call static GraphQL operations through typed adapter'
  }

  browser -> webUi 'Load client bundle + public runtime API URL' #contextOnly
  browser -> server.productSurface.authApi 'Direct login / session / logout with credentialed CORS'
  browser -> server.productSurface.publicApi 'Direct authenticated Project, Run and Queue queries/mutations'
  browser -> server.productSurface.auditApi 'Project Audits UI: bounded revision polling, lifecycle commands, coverage/findings/reviews/report'
  browser -> server.productSurface.userArtifactApi 'Direct UserScope / ProjectScope Artifact queries/uploads/downloads'
  browser -> server.runtimeOperations.operationsApi 'Direct Runtime visibility and configuration management'
  browser -> server.productSurface.eventApi 'Direct read-only WebSocket: Run/Planner stream + Operations invalidation'
  apiClient -> server 'Operate Workflow Runs without the UI' #contextOnly
  apiClient -> server.productSurface.authApi 'Authenticate through the same local session contract when needed'
  apiClient -> server.productSurface.publicApi 'Manage Projects, Queue and Runs without the UI'
  apiClient -> server.productSurface.auditApi 'Read exact profiles; manage owner Audits and exact human decisions'
  apiClient -> server.productSurface.userArtifactApi 'Upload / read / list UserScope or ProjectScope artifacts'

  runtimeAgent.agentControl.registryClient -> server.runtimeOperations.controlPlane 'Agent mTLS: register / sequenced heartbeat+ack / observed availability'
  server.runtimeOperations.controlPlane -> runtimeAgent.agentControl.controlEndpoint 'Control Plane mTLS: prepare / state snapshot / finalize / abort / release'
  server.orchestration.workerInvokerTools -> runtimeAgent.workerExecution.a2aServer 'Control Plane mTLS + URI SAN: A2A to active in-process Worker'
  runtimeAgent.allocationCapabilities.artifactClient -> server.artifactPlane.artifactService 'Agent mTLS + allocation ID: RunScope operations; no owner/Project/DB/S3 authority'
  runtimeAgent.allocationCapabilities.securityFindingsTools -> server.auditCoordination.findingIntake 'mTLS POST /private/v1/allocations/{allocation_id}/finding-proposals with trusted invocation/submission IDs'

  server.workspaceLifecycle.projectStore -> artifactDatabase.projectState 'Persist Project metadata, targets, lifecycle and deletion claims'
  server.workspaceLifecycle.ownerQueueGate -> artifactDatabase.runState 'Persist owner pause state at the Stage-admission serialization boundary'
  server.workspaceLifecycle.runStore -> artifactDatabase.runState 'Persist Runs, StageExecutions, queue projection, immutable exact-match labels and idempotency; empty label value differs from absent key'
  server.auditCoordination.auditStore -> artifactDatabase.auditState 'Transactional claims/epochs, immutable manifests, execution-item attempts, receipts, coverage and retention provenance'
  server.runtimeOperations.schedulerSettingsService -> artifactDatabase.schedulerSettings 'Authoritative singleton GET / revision CAS; equal-value update is a no-op; restart reads durable value'
  server.orchestration.plannerSessionService -> artifactDatabase.plannerSessions 'Persist request/completion, typed plans and redacted ADK facts'
  server.artifactPlane.artifactRegistry -> artifactDatabase 'Transactional scoped registry writes and reads'
  server.artifactPlane.blobStore -> blobBackend 'Immutable blob operations'
  server.runtimeOperations.telemetry -> artifactDatabase.executionReports 'Persist bounded Contractor reports'

  runtimeAgent.workerExecution.executionCollector -> server.runtimeOperations.controlPlane 'Trusted allocation final report'
  runtimeAgent.allocationCapabilities.adapterHost -> telemetryBackend 'Content-free bounded OTLP export when selected'
  runtimeAgent.allocationCapabilities.adapterHost -> workerHttpProxy 'Selected Worker LLM/tool HTTP only; private Contractor traffic bypasses'

  server.orchestration.stagePlanner -> llmGateway 'Streamline/Router calls with resolved Planner policy/Gateway/credential'
  runtimeAgent.allocationCapabilities.modelClient -> llmGateway 'Worker/finalizer/summarizer calls with Control Plane-supplied resolved URL/token'
  server.identityConfiguration.executionConfigService -> llmGateway 'Create/delete LiteLLM virtual keys; Gateway enforces submitted key policy'
  llmGateway -> llmProvider 'Provider requests'

  server.runtimeOperations.telemetry -> telemetryBackend 'Export when configured'
  server.identityConfiguration.executionConfigService -> configFilesystem 'Load union / atomically publish immutable versions'
  server.orchestration.agentTemplateCatalog -> configFilesystem 'Load versioned templates and resolved instruction resources'
  server.orchestration.skillCatalog -> configFilesystem 'Validate and deterministically package bundled skill source trees before readiness'
  server.auditCoordination.profileCatalog -> configFilesystem 'Load seventh YAML/text subtree audit-profiles after Workflow resolution; no generic managed publication'
  server.auditCoordination.standardCatalog -> configFilesystem 'V26 operator-owned non-YAML configs/audit-standards sources; exact licensed packages'
  server.identityConfiguration.executionConfigService -> artifactDatabase.credentials 'Store/resolve encrypted pinned credentials'
  server.identityConfiguration.runtimeConfigService -> artifactDatabase.runtimeConfiguration 'Store immutable configs, CAS bindings and durable Agent labels'
  server.identityConfiguration.runtimeConfigService -> artifactDatabase.credentials 'Store/resolve encrypted adapter credentials just in time'
  server.identityConfiguration.runtimeConfigService -> credentialMasterKey 'Decrypt selected allocation/Planner adapter credentials just in time'
  server.identityConfiguration.executionConfigService -> credentialMasterKey 'Read bootstrap key at startup; decrypt just in time'
  server.identityConfiguration.executionConfigService -> gatewayAdminBindings 'Resolve exact Gateway binding; read LiteLLM master key at startup'
  server.identityConfiguration.authService -> localAuthBootstrap 'Read one user ID, username and Argon2id hash at startup'
}
// Focused views select model relationships and shorten their display titles.
// Existing navigation IDs are preserved. Dashed #planned components describe
// specified delivery work, not currently available product functionality.

views {
  global style ownership

  // Keep optional components readable; mark optionality explicitly in titles.
  style element.tag = #optional {
    opacity 100%
  }

  view index {
    title '01 / System Context'
    description 'Primary deployables and data paths. Configs, secrets and optional infrastructure have dedicated views.'

    include browser with {
      title 'User Browser'
    }
    include webUi with {
      title 'Web UI'
    }
    include server with {
      title 'Contractor Server'
      navigateTo serverOverview
    }
    include apiClient with {
      title 'API Client'
    }
    include runtimeAgent with {
      title 'Runtime Agent'
      navigateTo runtimeOverview
    }
    include artifactDatabase with {
      title 'PostgreSQL'
    }
    include blobBackend with {
      title 'Artifact Blobs'
    }
    include llmGateway with {
      title 'LLM Gateway'
    }
    include llmProvider with {
      title 'Model Provider'
    }

    // Show only the relationships relevant to this view.
    exclude * -> *
    include browser -> webUi with {
      title 'Load SPA'
    }
    include browser -> server with {
      title 'HTTPS API / WebSocket'
    }
    include apiClient -> server with {
      title 'Authenticated API'
    }
    include server -> runtimeAgent with {
      title 'mTLS control / A2A'
    }
    include runtimeAgent -> server with {
      title 'Registration / Run artifacts'
    }
    include server -> artifactDatabase with {
      title 'Transactional state'
    }
    include server -> blobBackend with {
      title 'Immutable blobs'
    }
    include server -> llmGateway with {
      title 'Planner / key management'
    }
    include runtimeAgent -> llmGateway with {
      title 'Worker model calls'
    }
    include llmGateway -> llmProvider with {
      title 'Provider requests'
    }

    autoLayout LeftRight 100 70
  }

  view platformOverview {
    title '02 / Platform Responsibilities'
    description 'Server domains collaborate with a collapsed Runtime. Explore each domain for implementation details.'

    include server.productSurface with {
      title 'Product APIs'
      navigateTo productSurface
    }
    include server.identityConfiguration with {
      title 'Identity & Configuration'
      navigateTo runtimeConfiguration
    }
    include server.workspaceLifecycle with {
      title 'Projects & Queue'
      navigateTo workspaceLifecycle
    }
    include server.orchestration with {
      title 'Workflow Orchestration'
      navigateTo stageExecution
    }
    include server.auditCoordination with {
      title 'Audit Coordination'
      navigateTo audits
    }
    include server.artifactPlane with {
      title 'Artifact Storage'
      navigateTo artifacts
    }
    include server.runtimeOperations with {
      title 'Runtime Operations'
      navigateTo controlPlane
    }
    include runtimeAgent with {
      title 'Runtime Agent'
      navigateTo runtimeOverview
    }

    // Show only the relationships relevant to this view.
    exclude * -> *
    include server.productSurface -> server.identityConfiguration with {
      title 'Authenticate'
    }
    include server.productSurface -> server.workspaceLifecycle with {
      title 'Projects / Runs / Queue'
    }
    include server.productSurface -> server.orchestration with {
      title 'Create / cancel Runs'
    }
    include server.productSurface -> server.auditCoordination with {
      title 'Audits / profiles / review'
    }
    include server.auditCoordination -> server.orchestration with {
      title 'Pinned ordinary child Runs'
    }
    include server.auditCoordination -> server.artifactPlane with {
      title 'Exact baseline / retained evidence'
    }
    include server.productSurface -> server.artifactPlane with {
      title 'Owner artifacts'
    }
    include server.orchestration -> server.workspaceLifecycle with {
      title 'Admission / lifecycle'
    }
    include server.orchestration -> server.artifactPlane with {
      title 'Pin inputs / publish outputs'
    }
    include server.orchestration -> server.runtimeOperations with {
      title 'Prepare / finalize'
    }
    include server.runtimeOperations -> runtimeAgent with {
      title 'Private control'
    }
    include runtimeAgent -> server.artifactPlane with {
      title 'Allocation-bound RunScope'
    }
    global predicate withoutContextOnly

    autoLayout TopBottom 100 70
  }

  view serverOverview {
    title '03 / Server Subsystems'
    description 'Internal responsibilities. Storage and Runtime protocols are shown in focused views.'

    include server.productSurface with {
      title 'Product APIs'
      navigateTo productSurface
    }
    include server.identityConfiguration with {
      title 'Identity & Configuration'
      navigateTo runtimeConfiguration
    }
    include server.workspaceLifecycle with {
      title 'Projects & Queue'
      navigateTo workspaceLifecycle
