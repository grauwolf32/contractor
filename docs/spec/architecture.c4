    include server.orchestration -> server.identityConfiguration with {
      title 'Execution inputs'
    }
    include server.orchestration -> server.workspaceLifecycle with {
      title 'Stage admission / lifecycle'
    }
    include server.orchestration -> server.runtimeOperations with {
      title 'Allocations / reports'
    }
    include server.orchestration -> server.artifactPlane with {
      title 'Inputs / outputs / memory'
    }
    include server.workspaceLifecycle -> server.orchestration with {
      title 'Cancel and drain'
    }
    include server.workspaceLifecycle -> server.artifactPlane with {
      title 'Released scope purge'
    }
    include server.runtimeOperations -> server.identityConfiguration with {
      title 'Credentials / Runtime settings'
    }
    global predicate withoutContextOnly

    autoLayout TopBottom 100 70
  }

  view runtimeOverview {
    title '04 / Runtime Agent Subsystems'
    description 'One process owns one slot. Agent Control owns allocation resources and Worker lifecycle.'

    include server with {
      title 'Contractor Server'
      navigateTo serverOverview
    }
    include runtimeAgent.agentControl with {
      title 'Agent Control'
      navigateTo controlPlane
    }
    include runtimeAgent.workerExecution with {
      title 'Worker Execution'
      navigateTo runtimeLifecycle
    }
    include runtimeAgent.allocationCapabilities with {
      title 'Allocation Capabilities'
      navigateTo runtimeFilesystems
    }

    // Show only the relationships relevant to this view.
    exclude * -> *
