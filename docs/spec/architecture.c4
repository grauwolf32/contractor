      title 'mTLS control'
    }
    include runtimeAgent.agentControl -> server with {
      title 'Register / heartbeat'
    }
    include server -> runtimeAgent.workerExecution with {
      title 'Allocation A2A'
    }
    include runtimeAgent.agentControl -> runtimeAgent.workerExecution with {
      title 'Own Worker / sessions / State'
    }
    include runtimeAgent.agentControl -> runtimeAgent.allocationCapabilities with {
      title 'Prepare / destroy resources'
    }
    include runtimeAgent.workerExecution -> runtimeAgent.allocationCapabilities with {
