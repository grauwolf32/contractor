  view runtimeFilesystems {
    title 'Runtime / Workspaces and File Tools'
    description 'V30 release-verified: local direct disk is authoritative, including external writes; commands/edits/snapshots share workspace ownership. Memory and overlay remain independent; overlay export stays bounded at 16 MiB.'

    include runtimeAgent.agentControl.slotManager with {
      title 'Exclusive Allocation Slot'
