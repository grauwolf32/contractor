specification {
  element actor {
    style {
      shape person
    }
  }

  element system

  element component {
    style {
      shape rectangle
    }
  }

  element storage {
    style {
      shape storage
    }
  }

  tag contractor
  tag adk
  tag external
  tag optional
  tag contextOnly
}

global {
  styleGroup ownership {
    style element.tag = #contractor {
      color primary
    }
    style element.tag = #adk {
      color green
    }
    style element.tag = #external {
      color gray
      border dashed
    }
    style element.tag = #optional {
      opacity 60%
    }
  }
}

model {
  browser = actor 'User Browser' {
    #external
  }

  apiClient = actor 'Non-UI API Client' {
    #external
  }

  webUi = system 'Contractor Web UI — React/TypeScript SPA on a separate Node.js service' {
    #contractor
  }

  llmGateway = system 'LLM Gateway — LiteLLM or compatible backend' {
    #external
  }

  llmProvider = system 'Model Provider' {
    #external
  }

  configFilesystem = system 'Published YAML — operator + managed roots' {
    #external
  }

  credentialMasterKey = system 'Credential Master-Key File — host bootstrap secret' {
    #external
  }

  gatewayAdminBindings = system 'Gateway Admin Bindings + LiteLLM Master-Key Files — host bootstrap secrets' {
    #external
  }

  localAuthBootstrap = system 'Local Auth File — one user + Argon2id password hash' {
    #external
  }

  artifactDatabase = system 'PostgreSQL — Contractor State' {
    #external

    runState = storage 'Workflow snapshots / Runs / StageExecutions / semantic results / Run event journal' {
      #contractor
    }

    plannerSessions = storage 'Contractor Planner Sessions — completion recovery + typed plans + redacted ADK facts' {
      #contractor
    }

    executionReports = storage 'Execution reports / accepted StageMetrics' {
      #contractor
    }

    credentials = storage 'AES-256-GCM encrypted immutable LLM credentials' {
      #contractor
    }

    artifactVersions = storage 'Artifact versions / scoped logical bindings / CAS' {
      #contractor
    }

    artifactEvents = storage 'Scoped artifact events / grants / lineage' {
      #contractor
    }
  }

  blobBackend = system 'Artifact Blob Backend — PostgreSQL or S3' {
    #external
  }

  telemetryBackend = system 'Telemetry Backend — optional' {
    #external
    #optional
  }

  server = system 'Contractor Server' {
    #contractor

    publicApi = component 'Run API' {
      #contractor
    }

    userArtifactApi = component 'User Artifact API' {
      #contractor
    }

    operationsApi = component 'Operations / Configuration API' {
      #contractor
    }

    authApi = component 'Local Login / Session / CSRF API' {
      #contractor
    }

    eventApi = component 'Read-only WebSocket Event API' {
      #contractor
    }

    authService = component 'In-memory Local Session + Principal Boundary' {
      #contractor
    }

    executionConfigService = component 'Execution Profiles + Model/Gateway Config + Credential Boundary' {
      #contractor
    }

    workflowCatalog = component 'Workflow Catalog' {
      #contractor
    }

    agentTemplateCatalog = component 'AgentTemplate Catalog — versioned behavior definitions' {
      #contractor
    }

    workflowScheduler = component 'Workflow Scheduler' {
      #contractor
    }

    plannerFactories = component 'PlannerFactory Registry' {
      #contractor
    }

    stagePlanner = component 'Stage-local Planner — Passthrough, Streamline or Router ADK' {
      #contractor
    }

    plannerSessionService = component 'Database-backed Planner SessionService' {
      #contractor
    }

    workerInvokerTools = component 'Validated Current-Subtask Adapter — direct A2A WorkerInvoker' {
      #contractor
    }

    plannerArtifactInspector = component 'Planner ArtifactInspector — exact RunScope validation' {
      #contractor
    }

    controlPlane = component 'Control Plane' {
      #contractor
    }

    runtimeRegistry = component 'Runtime Agent Registry / Slot Allocator' {
      #contractor
    }

    artifactService = component 'ArtifactStore Service — UserScope / RunScope' {
      #contractor
    }

    artifactRegistry = component 'Artifact Registry Adapter' {
      #contractor
    }

    blobStore = component 'ArtifactBlobStore Adapter' {
      #contractor
    }

    runStore = component 'WorkflowRun / StageExecution Store' {
      #contractor
    }

    telemetry = component 'Execution Report Collector / optional exporters' {
      #contractor
    }

    publicApi -> workflowScheduler 'Start / query / cancel Workflow Run'
    userArtifactApi -> artifactService 'Authenticated UserScope operations / explicit output publication'
    operationsApi -> runtimeRegistry 'Read authoritative/observed slot state'
    operationsApi -> executionConfigService 'List/publish configs; create/delete managed credentials without raw tokens'
    authApi -> authService 'Verify Argon2id login; issue/revoke session + CSRF'
    publicApi -> authService 'Authenticate session and bind user principal'
    userArtifactApi -> authService 'Authenticate session and bind UserScope owner'
    operationsApi -> authService 'Authenticate session and bind audit actor'
    eventApi -> authService 'Authenticate socket/session/origin and authorize subscriptions'
    eventApi -> runStore 'Replay ordered committed Run lifecycle events'
    eventApi -> plannerSessionService 'Stream only committed redacted Planner facts'
    eventApi -> runtimeRegistry 'Observe process-local Operations revisions; require resync on gaps'
    workflowScheduler -> workflowCatalog 'Resolve Workflow and select ready StageSpec'
    workflowCatalog -> executionConfigService 'Resolve exact digest-bearing escalation profiles'
    workflowScheduler -> agentTemplateCatalog 'Resolve and pin exact Stage AgentTemplates'
    workflowScheduler -> executionConfigService 'Resolve immutable per-Run executionConfig'
    workflowScheduler -> controlPlane 'Prepare / finalize / abort / release allocations'
    workflowScheduler -> plannerFactories 'Select declared PlannerFactory'
    plannerFactories -> stagePlanner 'Construct Passthrough/one-Worker Streamline/logical multi-Worker Router'
    plannerFactories -> executionConfigService 'Resolve pinned Planner credential'
    stagePlanner -> workerInvokerTools 'Dispatch exact current subtask sequentially; Router selects logical worker_name'
    workflowScheduler -> runStore 'CAS WorkflowRun lifecycle; persist attempts, candidates and terminal outcomes'
    workflowScheduler -> artifactService 'Pin/fork inputs; transactionally bind exact accepted Run outputs'
    stagePlanner -> plannerArtifactInspector 'Validate exact input, intermediate and candidate refs'
    stagePlanner -> plannerSessionService 'Durable request/completion, typed plan projection and redacted ADK facts'
    plannerArtifactInspector -> artifactService 'Read exact metadata inside current RunScope'

    controlPlane -> runtimeRegistry 'Track live instances / reserve free single slots'
    controlPlane -> executionConfigService 'Resolve pinned Worker credentials for RuntimeSettings'
    artifactService -> artifactRegistry 'Versions / bindings / CAS / grants / events'
    artifactService -> blobStore 'Stream immutable content'
    controlPlane -> telemetry 'Bind allocation final reports to trusted execution identity'
    workflowScheduler -> telemetry 'Assemble bounded StageMetrics while finalizing or aborting'
    stagePlanner -> telemetry 'Planner ExecutionReport'
  }

  runtimeAgent = system 'Runtime Agent — N identical single-slot processes' {
    #contractor

    controlEndpoint = component 'Private Control Endpoint' {
      #contractor
    }

    registryClient = component 'Registration / Heartbeat Client' {
      #contractor
    }

    slotManager = component 'Exclusive Slot / Allocation Context' {
      #contractor
    }

    a2aServer = component 'Allocation-scoped A2A Server' {
      #contractor
    }

    workerRuntime = component 'In-process Worker Runtime — ADK initially, configured by AgentTemplate' {
      #contractor
    }

    workerState = component 'In-memory Worker Session / State' {
      #contractor
    }

    executionCollector = component 'Execution / allocation report collector' {
      #contractor
    }

    sandboxManager = component 'SandboxProfile manager — local-workdir@1 initially, lifecycle isolation only' {
      #contractor
    }

    namespaceTools = component 'Explicitly selected Namespace-bound domain tools' {
      #contractor
    }

    runArtifactTools = component 'Explicitly selected run-artifacts@1 tools' {
      #contractor
    }

    artifactClient = component 'Private Artifact API Client / ADK Adapter' {
      #contractor
    }

    modelClient = component 'Model Client — optional' {
      #contractor
      #optional
    }

    controlEndpoint -> slotManager 'Reserve / configure / finalize / abort / release the only slot'
    slotManager -> workerRuntime 'Create / destroy one in-process Worker instance'
    slotManager -> a2aServer 'Activate / deactivate allocation identity and Agent Card'
    slotManager -> workerState 'Create / destroy allocation-local Session and State'
    slotManager -> sandboxManager 'Prepare fresh allocation workdir; clean before idle or remain fenced'
    a2aServer -> workerRuntime 'Deliver sequential A2A Tasks for active allocation'
    workerRuntime -> workerState 'Read / update in-memory allocation State'
    workerRuntime -> executionCollector 'Accumulate bounded metrics across allocation'
    controlEndpoint -> executionCollector 'Finalize or abort cached reports without semantic work'
    workerRuntime -> namespaceTools 'Construct only AgentTemplate-selected domain tools for fixed Namespace'
    workerRuntime -> runArtifactTools 'Construct selected list/read/write operations; grant remains authoritative'
    namespaceTools -> artifactClient 'Logical reads / immutable writes / CAS'
    runArtifactTools -> artifactClient 'Read/write/list with explicit CAS preconditions'
    workerRuntime -> modelClient 'Model calls when required'
  }

  browser -> webUi 'Load client bundle + public runtime API URL' #contextOnly
  browser -> server.authApi 'Direct login / session / logout with credentialed CORS'
  browser -> server.publicApi 'Direct authenticated Workflow and Run queries/mutations'
  browser -> server.userArtifactApi 'Direct Artifact queries/uploads/downloads'
  browser -> server.operationsApi 'Direct Runtime visibility and configuration management'
  browser -> server.eventApi 'Direct read-only WebSocket: Run/Planner stream + Operations invalidation'
  apiClient -> server 'Operate Workflow Runs without the UI' #contextOnly
  apiClient -> server.authApi 'Authenticate through the same local session contract when needed'
  apiClient -> server.publicApi 'Submit / query / cancel Run'
  apiClient -> server.userArtifactApi 'Upload / read / list UserScope; publish authorized Run output'

  runtimeAgent.registryClient -> server.controlPlane 'Agent mTLS: register / sequenced heartbeat+ack / observed availability'
  server.controlPlane -> runtimeAgent.controlEndpoint 'Control Plane mTLS: AllocationSpec + RuntimeSettings / finalize / abort / release'
  server.workerInvokerTools -> runtimeAgent.a2aServer 'Control Plane mTLS + URI SAN: A2A to active in-process Worker'
  runtimeAgent.artifactClient -> server.artifactService 'Agent mTLS + allocation ID: RunScope operations; no DB/S3 credentials'

  server.artifactRegistry -> artifactDatabase 'Transactional registry writes and reads'
  server.blobStore -> blobBackend 'Immutable blob operations'
  server.runStore -> artifactDatabase.runState 'Durable WorkflowRun and StageExecution state'
  server.plannerSessionService -> artifactDatabase.plannerSessions 'Persist request/completion, typed plans and redacted ADK facts'
  server.telemetry -> artifactDatabase.executionReports 'Persist bounded Contractor reports'

  runtimeAgent.executionCollector -> server.controlPlane 'Trusted allocation final report'

  server.stagePlanner -> llmGateway 'Streamline/Router calls with resolved Planner policy/Gateway/credential'
  runtimeAgent.modelClient -> llmGateway 'Worker calls with Control Plane-supplied resolved URL/token'
  server.executionConfigService -> llmGateway 'Create/delete LiteLLM virtual keys; Gateway enforces submitted key policy'
  llmGateway -> llmProvider 'Provider requests'

  server.telemetry -> telemetryBackend 'Export when configured'
  server.executionConfigService -> configFilesystem 'Load union / atomically publish immutable versions'
  server.executionConfigService -> artifactDatabase.credentials 'Store/resolve encrypted pinned credentials'
  server.executionConfigService -> credentialMasterKey 'Read bootstrap key at startup; decrypt just in time'
  server.executionConfigService -> gatewayAdminBindings 'Resolve exact Gateway binding; read LiteLLM master key at startup'
  server.authService -> localAuthBootstrap 'Read one user ID, username and Argon2id hash at startup'
}

views {
  view index {
    title 'Contractor v2 — System Context'

    include browser
    include apiClient
    include webUi
    include server
    include runtimeAgent
    include artifactDatabase
    include blobBackend
    include llmGateway
    include llmProvider
    include configFilesystem
    include credentialMasterKey
    include gatewayAdminBindings
    include localAuthBootstrap
    include telemetryBackend

    global style ownership
    autoLayout LeftRight
  }

  view stageExecution {
    title 'Contractor v2 — Prepared Stage Execution'

    include server
    include server.publicApi
    include server.workflowCatalog
    include server.agentTemplateCatalog
    include server.workflowScheduler
    include server.plannerFactories
    include server.stagePlanner
    include server.plannerSessionService
    include server.workerInvokerTools
    include server.controlPlane
    include server.runtimeRegistry
    include server.runStore
    include server.telemetry

    include runtimeAgent
    include runtimeAgent.controlEndpoint
    include runtimeAgent.registryClient
    include runtimeAgent.slotManager
    include runtimeAgent.a2aServer
    include runtimeAgent.workerRuntime
    include runtimeAgent.workerState
    include runtimeAgent.executionCollector

    exclude * -> * where tag is #contextOnly

    global style ownership
    autoLayout LeftRight
  }

  view plannerAndA2A {
    title 'Contractor v2 — Planner and A2A Worker Boundary'

    include server
    include server.workflowScheduler
    include server.plannerFactories
    include server.stagePlanner
    include server.plannerSessionService
    include server.workerInvokerTools

    include runtimeAgent
    include runtimeAgent.a2aServer
    include runtimeAgent.workerRuntime
    include runtimeAgent.workerState
    include runtimeAgent.executionCollector

    include llmGateway

    exclude * -> * where tag is #contextOnly

    global style ownership
    autoLayout LeftRight
  }

  view runtimeLifecycle {
    title 'Contractor v2 — Single-process Runtime Agent / Worker Lifecycle'

    include server
    include server.workflowScheduler
    include server.agentTemplateCatalog
    include server.controlPlane
    include server.runtimeRegistry

    include runtimeAgent
    include runtimeAgent.controlEndpoint
    include runtimeAgent.registryClient
    include runtimeAgent.slotManager
    include runtimeAgent.sandboxManager
    include runtimeAgent.a2aServer
    include runtimeAgent.workerRuntime
    include runtimeAgent.workerState
    include runtimeAgent.executionCollector
    include runtimeAgent.artifactClient

    exclude * -> * where tag is #contextOnly

    global style ownership
    autoLayout LeftRight
  }

  view artifacts {
    title 'Contractor v2 — ArtifactStore Scopes, Forks and Run Namespaces'

    include apiClient
    include server
    include server.userArtifactApi
    include server.workflowScheduler
    include server.stagePlanner
    include server.plannerArtifactInspector
    include server.artifactService
    include server.artifactRegistry
    include server.blobStore

    include runtimeAgent
    include runtimeAgent.workerRuntime
    include runtimeAgent.namespaceTools
    include runtimeAgent.runArtifactTools
    include runtimeAgent.artifactClient

    include artifactDatabase
    include artifactDatabase.artifactVersions
    include artifactDatabase.artifactEvents
    include blobBackend

    exclude * -> * where tag is #contextOnly

    global style ownership
    autoLayout LeftRight
  }

  view controlPlane {
    title 'Contractor v2 — Control Plane and Single-slot Runtime Fleet'

    include server
    include server.workflowScheduler
    include server.agentTemplateCatalog
    include server.controlPlane
    include server.runtimeRegistry

    include runtimeAgent
    include runtimeAgent.controlEndpoint
    include runtimeAgent.registryClient
    include runtimeAgent.slotManager
    include runtimeAgent.workerRuntime

    exclude * -> * where tag is #contextOnly

    global style ownership
    autoLayout LeftRight
  }
}
